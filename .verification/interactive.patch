+	"github.com/lux-tui/lux/render"
+	"github.com/rivo/uniseg"
+)
+
+// ButtonStyle defines the four visual states of a button. Zero values inherit
+// Normal; Disabled also disables interaction.
+type ButtonStyle struct {
+	Normal        render.Style
+	Focused       render.Style
+	Hovered       render.Style
+	Pressed       render.Style
+	DisabledStyle render.Style
+	Border        render.Border
+	Disabled      bool
+}
+
+// Button registers and draws one keyboard/pointer activatable control.
+func (c *Context) Button(id ID, canvas *render.Canvas, bounds render.Rect, label string, style ButtonStyle) {
+	if canvas == nil || bounds.Empty() {
+		return
+	}
+	bounds = bounds.Intersect(canvas.Bounds())
+	if bounds.Empty() {
+		return
+	}
+	flags := Focusable | Activatable
+	if style.Disabled {
+		flags |= Disabled
+	}
+	c.Region(id, canvas, bounds, flags)
+	visual := style.Normal
+	switch {
+	case style.Disabled:
+		visual = fallbackStyle(style.DisabledStyle, visual)
+	case c.Pressed(id):
+		visual = fallbackStyle(style.Pressed, visual)
+	case c.Focused(id):
+		visual = fallbackStyle(style.Focused, visual)
+	case c.Hovered(id):
+		visual = fallbackStyle(style.Hovered, visual)
+	}
+	canvas = canvas.Clip(bounds)
+	canvas.Fill(bounds, " ", visual)
+	border := style.Border
+	if border == (render.Border{}) {
+		border = render.RoundedBorder
+	}
+	canvas.Border(bounds, border, visual)
+	inner := bounds.Inset(1, 1)
+	if inner.Empty() {
+		inner = bounds
+	}
+	label = clipText(label, inner.W)
+	canvas.Text(inner.X+max((inner.W-render.TextWidth(label))/2, 0), inner.Y+max((inner.H-1)/2, 0), label, visual)
+}
+
+// ListState is the persistent selection and scroll position for a List.
+type ListState struct {
+	Selected int
+	Offset   int
+}
+
+// Apply mutates selection/offset for a routed List action. rows is the number
+// of visible item rows. Enter/space activates without moving selection.
+func (s *ListState) Apply(action Action, count, rows int) (changed, activated bool) {
+	if s == nil {
+		return false, false
+	}
+	beforeSelected, beforeOffset := s.Selected, s.Offset
+	count, rows = max(count, 0), max(rows, 0)
+	if count == 0 {
+		s.Selected, s.Offset = 0, 0
+		return beforeSelected != 0 || beforeOffset != 0, false
+	}
+	s.Selected = min(max(s.Selected, 0), count-1)
+	s.Offset = min(max(s.Offset, 0), max(count-rows, 0))
+	beforeSelected, beforeOffset = s.Selected, s.Offset
+
+	switch action.Kind {
+	case Activate:
+		activated = true
+	case Scroll:
+		switch action.Event.Kind {
+		case event.Key:
+			switch action.Event.Key.Code {
+			case event.KeyUp:
+				s.Selected--
+			case event.KeyDown:
+				s.Selected++
+			case event.KeyHome:
+				s.Selected = 0
+			case event.KeyEnd:
+				s.Selected = count - 1
+			case event.KeyPageUp:
+				s.Selected -= max(rows, 1)
+			case event.KeyPageDown:
+				s.Selected += max(rows, 1)
+			}
+		case event.Mouse:
+			switch action.Event.Mouse.Action {
+			case event.MouseWheel:
+				delta := max(rows/3, 1)
+				switch action.Event.Mouse.Button {
+				case event.MouseWheelUp, event.MouseWheelLeft:
+					s.Selected -= delta
+				case event.MouseWheelDown, event.MouseWheelRight:
+					s.Selected += delta
+				}
+			case event.MousePress:
+				if index := s.Offset + action.Y; action.Y >= 0 && action.Y < rows && index < count {
+					s.Selected = index
+				}
+			}
+		}
+	}
+	s.Selected = min(max(s.Selected, 0), count-1)
+	s.ensureVisible(count, rows)
+	return beforeSelected != s.Selected || beforeOffset != s.Offset, activated
+}
+
+func (s *ListState) ensureVisible(count, rows int) {
+	if rows <= 0 || count <= 0 {
+		s.Offset = 0
+		return
+	}
+	if s.Selected < s.Offset {
+		s.Offset = s.Selected
+	}
+	if s.Selected >= s.Offset+rows {
+		s.Offset = s.Selected - rows + 1
+	}
+	s.Offset = min(max(s.Offset, 0), max(count-rows, 0))
+}
+
+// ListStyle defines list row states. Zero values inherit Normal.
+type ListStyle struct {
+	Normal        render.Style
+	Selected      render.Style
+	Focused       render.Style
+	Hovered       render.Style
+	DisabledStyle render.Style
+	Disabled      bool
+	Marker        string
+}
+
+// List registers and draws a focusable, scrollable list. Apply its routed
+// actions in Model.Update; View is side-effect free except for bounds repair.
+func (c *Context) List(id ID, canvas *render.Canvas, bounds render.Rect, state *ListState, items []string, style ListStyle) {
+	if canvas == nil || state == nil || bounds.Empty() {
+		return
+	}
+	bounds = bounds.Intersect(canvas.Bounds())
+	if bounds.Empty() {
+		return
+	}
+	flags := Focusable | Scrollable | Activatable
+	if style.Disabled {
+		flags |= Disabled
+	}
+	c.RegionWithOptions(id, canvas, bounds, flags, RegionOptions{ContentHeight: min(bounds.H, max(len(items)-state.Offset, 0))})
+	state.Selected = min(max(state.Selected, 0), max(len(items)-1, 0))
+	state.ensureVisible(len(items), bounds.H)
+	canvas = canvas.Clip(bounds)
+	canvas.Fill(bounds, " ", style.Normal)
+	marker := style.Marker
+	if marker == "" {
+		marker = "> "
+	}
+	for row := 0; row < bounds.H; row++ {
+		index := state.Offset + row
+		if index >= len(items) {
+			break
+		}
+		visual := style.Normal
+		if style.Disabled {
+			visual = fallbackStyle(style.DisabledStyle, visual)
+		} else if index == state.Selected {
+			visual = fallbackStyle(style.Selected, visual)
+			if c.Focused(id) {
+				visual = fallbackStyle(style.Focused, visual)
+			} else if c.Hovered(id) {
+				visual = fallbackStyle(style.Hovered, visual)
+			}
+		}
+		y := bounds.Y + row
+		canvas.Fill(render.Rect{X: bounds.X, Y: y, W: bounds.W, H: 1}, " ", visual)
+		prefix := ""
+		if index == state.Selected {
+			prefix = marker
+		}
+		text := clipText(prefix+items[index], bounds.W)
+		canvas.Text(bounds.X, y, text, visual)
+	}
+}
+
+// ModalStyle defines the panel, border, and title styling of a modal.
+type ModalStyle struct {
+	Panel  render.Style
+	Border render.Style
+	Title  render.Style
+	Frame  render.Border
+}
+
+// Modal draws a modal panel, begins its input scope, and returns its interior.
+// Call EndModal after registering all modal controls.
+func (c *Context) Modal(id ID, canvas *render.Canvas, bounds render.Rect, title string, style ModalStyle) *render.Canvas {
+	if canvas == nil {
+		return nil
+	}
+	bounds = bounds.Intersect(canvas.Bounds())
+	c.BeginModal(id, canvas, bounds)
+	canvas.Fill(bounds, " ", style.Panel)
+	border := style.Frame
+	if border == (render.Border{}) {
+		border = render.RoundedBorder
+	}
+	canvas.Border(bounds, border, fallbackStyle(style.Border, style.Panel))
+	if bounds.W > 4 && title != "" {
+		canvas.Text(bounds.X+2, bounds.Y, " "+clipText(title, bounds.W-4)+" ", fallbackStyle(style.Title, style.Border))
+	}
+	return canvas.Subview(bounds.Inset(1, 1))
+}
+
+func fallbackStyle(preferred, fallback render.Style) render.Style {
+	if preferred == (render.Style{}) {
+		return fallback
+	}
+	return preferred
+}
+
+func clipText(text string, width int) string {
+	if width <= 0 {
+		return ""
+	}
+	if render.TextWidth(text) <= width {
+		return text
+	}
+	var result strings.Builder
+	used := 0
+	graphemes := uniseg.NewGraphemes(text)
+	for graphemes.Next() {
+		cluster := graphemes.Str()
+		cells := render.GraphemeWidth(cluster)
+		if used+cells > width {
+			break
+		}
+		result.WriteString(cluster)
+		used += cells
+	}
+	return result.String()
+}
diff --git a/ui/controls_test.go b/ui/controls_test.go
new file mode 100644
index 0000000..c80d842
--- /dev/null
+++ b/ui/controls_test.go
@@ -0,0 +1,109 @@
+package ui
+
+import (
+	"testing"
+
+	"github.com/lux-tui/lux/event"
+	"github.com/lux-tui/lux/render"
+)
+
+func keyAction(code event.KeyCode) Action {
+	return Action{Kind: Scroll, Event: event.KeyPress(code, 0)}
+}
+
+func TestListStateKeyboardScrollAndBounds(t *testing.T) {
+	state := ListState{Selected: 1}
+	if changed, activated := state.Apply(keyAction(event.KeyPageDown), 10, 3); !changed || activated || state.Selected != 4 || state.Offset != 2 {
+		t.Fatalf("pagedown = %#v changed=%v activated=%v", state, changed, activated)
+	}
+	state.Apply(keyAction(event.KeyEnd), 10, 3)
+	if state.Selected != 9 || state.Offset != 7 {
+		t.Fatalf("end = %#v", state)
+	}
+	state.Apply(keyAction(event.KeyHome), 10, 3)
+	if state.Selected != 0 || state.Offset != 0 {
+		t.Fatalf("home = %#v", state)
+	}
+	state.Selected, state.Offset = 99, 99
+	if changed, _ := state.Apply(Action{}, 2, 0); !changed || state.Selected != 1 || state.Offset != 0 {
+		t.Fatalf("tiny = %#v changed=%v", state, changed)
+	}
+	state.Apply(Action{}, 2, 1)
+	if changed, activated := state.Apply(Action{Kind: Activate}, 2, 1); changed || !activated {
+		t.Fatalf("activate changed=%v activated=%v", changed, activated)
+	}
+	if changed, activated := state.Apply(Action{}, 0, 0); !changed || activated || state != (ListState{}) {
+		t.Fatalf("empty = %#v changed=%v activated=%v", state, changed, activated)
+	}
+}
+
+func TestListStateWheelAndClick(t *testing.T) {
+	state := ListState{}
+	wheel := Action{Kind: Scroll, Event: event.Event{Kind: event.Mouse, Mouse: event.MouseEvent{Action: event.MouseWheel, Button: event.MouseWheelDown}}}
+	state.Apply(wheel, 20, 6)
+	if state.Selected != 2 || state.Offset != 0 {
+		t.Fatalf("wheel = %#v", state)
+	}
+	click := Action{Kind: Scroll, Y: 4, Event: event.Event{Kind: event.Mouse, Mouse: event.MouseEvent{Action: event.MousePress, Button: event.MouseLeft}}}
+	changed, activated := state.Apply(click, 20, 6)
+	if !changed || activated || state.Selected != 4 {
+		t.Fatalf("click = %#v changed=%v activated=%v", state, changed, activated)
+	}
+	if changed, activated = state.Apply(Action{Kind: Activate}, 20, 6); changed || !activated {
+		t.Fatalf("release changed=%v activated=%v", changed, activated)
+	}
+	outside := click
+	outside.Y = 8
+	if changed, activated = state.Apply(outside, 20, 6); changed || activated {
+		t.Fatalf("outside changed=%v activated=%v", changed, activated)
+	}
+	state = ListState{}
+	blank := click
+	blank.Y = 5
+	if changed, activated = state.Apply(blank, 2, 6); changed || activated || state != (ListState{}) {
+		t.Fatalf("blank changed=%v activated=%v state=%#v", changed, activated, state)
+	}
+}
+
+func TestButtonListAndModalRendering(t *testing.T) {
+	buffer := render.NewBuffer(32, 12)
+	canvas := render.NewCanvas(buffer)
+	var ctx Context
+	ctx.begun = true
+	ctx.viewFocus = "button"
+	ctx.Button("button", canvas, render.Rect{X: 1, Y: 1, W: 10, H: 3}, "Run 界", ButtonStyle{})
+	state := ListState{Selected: 1}
+	ctx.List("list", canvas, render.Rect{X: 1, Y: 5, W: 12, H: 3}, &state, []string{"one", "two", "three", "four"}, ListStyle{})
+	inner := ctx.Modal("help", canvas, render.Rect{X: 16, Y: 1, W: 14, H: 9}, "Help", ModalStyle{})
+	ctx.Region("close", inner, render.Rect{X: 1, Y: 1, W: 8, H: 2}, Focusable|Activatable)
+	ctx.EndModal()
+
+	if len(ctx.building) != 3 || ctx.building[2].modal != "help" {
+		t.Fatalf("regions = %#v", ctx.building)
+	}
+	if got := buffer.Cell(3, 2).Grapheme; got == " " {
+		t.Fatalf("button label not drawn: %q", got)
+	}
+	if got := buffer.Cell(1, 6).Grapheme; got == " " {
+		t.Fatal("selected list marker not drawn")
+	}
+	if width, height := inner.Size(); width != 12 || height != 7 {
+		t.Fatalf("modal inner = %dx%d", width, height)
+	}
+}
+
+func TestControlsTinyAndDisabledAreSafe(t *testing.T) {
+	buffer := render.NewBuffer(2, 1)
+	canvas := render.NewCanvas(buffer)
+	var ctx Context
+	ctx.begun = true
+	ctx.Button("x", canvas, render.Rect{W: 1, H: 1}, "too long", ButtonStyle{Disabled: true})
+	state := ListState{Selected: 4, Offset: 4}
+	ctx.List("list", canvas, render.Rect{X: 1, W: 1, H: 1}, &state, nil, ListStyle{Disabled: true})
+	if state != (ListState{}) {
+		t.Fatalf("empty list state = %#v", state)
+	}
+	if len(ctx.building) != 2 || ctx.building[0].flags&Disabled == 0 || ctx.building[1].flags&Disabled == 0 {
+		t.Fatalf("disabled regions = %#v", ctx.building)
+	}
+}
diff --git a/ui/textinput.go b/ui/textinput.go
new file mode 100644
index 0000000..25827c6
--- /dev/null
+++ b/ui/textinput.go
@@ -0,0 +1,600 @@
+package ui
+
+import (
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/lux-tui/lux/event"
+	"github.com/lux-tui/lux/render"
+	"github.com/rivo/uniseg"
+)
+
+// TextInput is the editable state of a one-line text field. Cursor, Anchor,
+// and Offset are UTF-8 byte offsets at extended-grapheme boundaries. Equal
+// Cursor and Anchor means there is no selection; the zero value is ready.
+type TextInput struct {
+	Value       string
+	Cursor      int
+	Anchor      int
+	MaxBytes    int
+	Offset      int
+	Placeholder string
+}
+
+// InputStyle controls painting and whether a field accepts interaction. Zero
+// Selection and Cursor styles inherit Normal with reverse video; a zero
+// Placeholder style inherits Normal with dim text.
+type InputStyle struct {
+	Normal      render.Style
+	Placeholder render.Style
+	Selection   render.Style
+	Cursor      render.Style
+	ReadOnly    bool
+	Disabled    bool
+}
+
+// SetValue replaces the value, applies the one-line input policy, moves the
+// caret to the end, and clears selection.
+func (t *TextInput) SetValue(value string) {
+	if t == nil {
+		return
+	}
+	t.Value = limitText(sanitizeInput(value), t.MaxBytes)
+	t.Cursor, t.Anchor, t.Offset = len(t.Value), len(t.Value), 0
+}
+
+// Selection returns the ordered half-open selected byte range. Equal values
+// mean no selection.
+func (t *TextInput) Selection() (start, end int) {
+	if t == nil {
+		return 0, 0
+	}
+	t.normalize()
+	if t.Cursor < t.Anchor {
+		return t.Cursor, t.Anchor
+	}
+	return t.Anchor, t.Cursor
+}
+
+// Apply applies one routed Input action and reports whether editable state
+// changed. It accepts committed text, bounded paste, navigation, deletion,
+// Ctrl+A, Ctrl+Left/Right UAX #29 word movement, and local mouse placement.
+func (t *TextInput) Apply(action Action) bool {
+	if t == nil || action.Kind != Input {
+		return false
+	}
+	before := *t
+	t.normalize()
+	switch action.Event.Kind {
+	case event.Text, event.Paste:
+		t.insert(action.Event.Text)
+	case event.Key:
+		t.applyKey(action.Event.Key)
+	case event.Mouse:
+		t.applyMouse(action)
+	}
+	return before.Value != t.Value || before.Cursor != t.Cursor || before.Anchor != t.Anchor || before.Offset != t.Offset
+}
+
+// Input registers and paints a one-line text input. Read-only fields remain
+// focusable but do not receive Input actions; disabled fields are inert.
+func (c *Context) Input(id ID, canvas *render.Canvas, rect render.Rect, input *TextInput, style InputStyle) {
+	if c == nil || canvas == nil || input == nil || id == "" {
+		return
+	}
+	input.normalize()
+	rect.H = min(max(rect.H, 0), 1)
+	line := rect.Intersect(canvas.Bounds())
+	flags := Focusable | Editable
+	if style.ReadOnly {
+		flags = Focusable
+	}
+	if style.Disabled {
+		flags |= Disabled
+	}
+	c.Region(id, canvas, line, flags)
+	if line.Empty() {
+		input.Offset = input.Cursor
+		return
+	}
+
+	base := style.Normal
+	if style.Disabled {
+		base.Attrs |= render.AttrDim
+	}
+	canvas.Fill(line, " ", base)
+	focused := c.Focused(id) && !style.ReadOnly && !style.Disabled
+	input.ensureOffset(line.W, focused)
+
+	placeholder := style.Placeholder
+	if placeholder == (render.Style{}) {
+		placeholder = base
+		placeholder.Attrs |= render.AttrDim
+	}
+	selection := style.Selection
+	if selection == (render.Style{}) {
+		selection = base
+		selection.Attrs |= render.AttrReverse
+	}
+	caret := style.Cursor
+	if caret == (render.Style{}) {
+		caret = base
+		caret.Attrs |= render.AttrReverse
+	}
+
+	if input.Value == "" {
+		drawPlaceholder(canvas, line, input.Placeholder, placeholder, caret, focused)
+		return
+	}
+	drawInput(canvas, line, input, base, selection, caret, focused)
+}
+
+func (t *TextInput) normalize() {
+	t.Value = limitText(sanitizeInput(t.Value), t.MaxBytes)
+	t.Cursor, t.Anchor, t.Offset = floorBoundaries(t.Value, t.Cursor, t.Anchor, t.Offset)
+}
+
+func (t *TextInput) applyKey(key event.KeyEvent) {
+	shift := key.Mod&event.ModShift != 0
+	ctrl := key.Mod&event.ModCtrl != 0
+	if key.Mod&(event.ModAlt|event.ModSuper) != 0 {
+		return
+	}
+	count := max(int(key.Repeat), 1)
+	count = min(count, uniseg.GraphemeClusterCount(t.Value)+1)
+
+	if key.Code == event.KeyRune && ctrl && unicode.ToLower(key.Rune) == 'a' {
+		t.Anchor, t.Cursor = 0, len(t.Value)
+		return
+	}
+	switch key.Code {
+	case event.KeyLeft:
+		for range count {
+			start, end := t.selection()
+			target := previousBoundary(t.Value, t.Cursor)
+			if ctrl {
+				target = previousWord(t.Value, t.Cursor)
+			} else if !shift && start != end {
+				target = start
+			}
+			t.move(target, shift)
+		}
+	case event.KeyRight:
+		for range count {
+			start, end := t.selection()
+			target := nextBoundary(t.Value, t.Cursor)
+			if ctrl {
+				target = nextWord(t.Value, t.Cursor)
+			} else if !shift && start != end {
+				target = end
+			}
+			t.move(target, shift)
+		}
+	case event.KeyHome:
+		t.move(0, shift)
+	case event.KeyEnd:
+		t.move(len(t.Value), shift)
+	case event.KeyBackspace:
+		if ctrl {
+			return
+		}
+		for range count {
+			start, end := t.selection()
+			if start == end {
+				start = previousBoundary(t.Value, t.Cursor)
+			}
+			if start == end {
+				break
+			}
+			t.remove(start, end)
+		}
+	case event.KeyDelete:
+		if ctrl {
+			return
+		}
+		for range count {
+			start, end := t.selection()
+			if start == end {
+				end = nextBoundary(t.Value, t.Cursor)
+			}
+			if start == end {
+				break
+			}
+			t.remove(start, end)
+		}
+	case event.KeyRune:
+		if !ctrl && !unicode.IsControl(key.Rune) {
+			t.insert(strings.Repeat(string(key.Rune), count))
+		}
+	}
+}
+
+func (t *TextInput) applyMouse(action Action) {
+	mouse := action.Event.Mouse
+	if mouse.Action != event.MousePress || mouse.Button != event.MouseLeft {
+		return
+	}
+	target := byteAtCell(t.Value, t.Offset, action.X, action.Bounds.W)
+	if mouse.Mod&event.ModShift != 0 {
+		t.Cursor = target
+	} else {
+		t.Cursor, t.Anchor = target, target
+	}
+}
+
+func (t *TextInput) move(target int, extend bool) {
+	target = floorBoundary(t.Value, target)
+	if extend {
+		t.Cursor = target
+		return
+	}
+	t.Cursor, t.Anchor = target, target
+}
+
+func (t *TextInput) insert(value string) {
+	value = sanitizeInput(value)
+	if value == "" {
+		return
+	}
+	start, end := t.selection()
+	limit := -1
+	if t.MaxBytes > 0 {
+		limit = t.MaxBytes - (len(t.Value) - (end - start))
+	}
+	value = graphemePrefix(value, limit)
+	if value == "" {
+		return
+	}
+	t.Value = t.Value[:start] + value + t.Value[end:]
+	t.Cursor = ceilBoundary(t.Value, start+len(value))
+	t.Anchor = t.Cursor
+	t.Offset = floorBoundary(t.Value, min(t.Offset, t.Cursor))
+}
+
+func (t *TextInput) remove(start, end int) {
+	if start < 0 || start >= end || end > len(t.Value) {
+		return
+	}
+	t.Value = t.Value[:start] + t.Value[end:]
+	t.Cursor = floorBoundary(t.Value, start)
+	t.Anchor = t.Cursor
+	t.Offset = floorBoundary(t.Value, min(t.Offset, t.Cursor))
+}
+
+func (t *TextInput) ensureOffset(width int, caret bool) {
+	if width <= 0 {
+		t.Offset = t.Cursor
+		return
+	}
+	if t.Offset > t.Cursor {
+		t.Offset = t.Cursor
+	}
+	needed := 0
+	if t.Cursor < len(t.Value) {
+		needed = max(render.GraphemeWidth(t.Value[t.Cursor:]), 1)
+	} else if caret {
+		needed = 1
+	}
+	for t.Offset < t.Cursor && textCells(t.Value[t.Offset:t.Cursor])+needed > width {
+		t.Offset = nextBoundary(t.Value, t.Offset)
+	}
+	if textCells(t.Value[t.Offset:t.Cursor])+needed > width {
+		t.Offset = t.Cursor
+	}
+	for t.Offset > 0 {
+		previous := previousBoundary(t.Value, t.Offset)
+		if textCells(t.Value[previous:t.Cursor])+needed > width {
+			break
+		}
+		t.Offset = previous
+	}
+}
+
+func drawInput(canvas *render.Canvas, line render.Rect, input *TextInput, normal, selection, caret render.Style, focused bool) {
+	selectedStart, selectedEnd := input.selection()
+	x, caretPending := 0, false
+	graphemes := uniseg.NewGraphemes(input.Value[input.Offset:])
+	for graphemes.Next() {
+		from, to := graphemes.Positions()
+		from, to = from+input.Offset, to+input.Offset
+		if from == input.Cursor {
+			caretPending = focused
+		}
+		cluster := graphemes.Str()
+		width := render.GraphemeWidth(cluster)
+		if width == 0 {
+			canvas.Put(line.X+x, line.Y, cluster, normal)
+			continue
+		}
+		if x+width > line.W {
+			break
+		}
+		paint := normal
+		if from >= selectedStart && to <= selectedEnd && selectedStart != selectedEnd {
+			paint = selection
+		}
+		if caretPending {
+			paint, caretPending = caret, false
+		}
+		canvas.Put(line.X+x, line.Y, cluster, paint)
+		x += width
+	}
+	if !focused || !caretPending && input.Cursor != len(input.Value) {
+		return
+	}
+	cursorX := textCells(input.Value[input.Offset:input.Cursor])
+	if cursorX >= 0 && cursorX < line.W {
+		canvas.Put(line.X+cursorX, line.Y, " ", caret)
+	}
+}
+
+func drawPlaceholder(canvas *render.Canvas, line render.Rect, value string, placeholder, caret render.Style, focused bool) {
+	x, first := 0, true
+	graphemes := uniseg.NewGraphemes(sanitizeInput(value))
+	for graphemes.Next() {
+		cluster := graphemes.Str()
+		width := render.GraphemeWidth(cluster)
+		if width == 0 {
+			continue
+		}
+		if x+width > line.W {
+			break
+		}
+		paint := placeholder
+		if focused && first {
+			paint = caret
+		}
+		canvas.Put(line.X+x, line.Y, cluster, paint)
+		x += width
+		first = false
+	}
+	if focused && first && line.W > 0 {
+		canvas.Put(line.X, line.Y, " ", caret)
+	}
+}
+
+func sanitizeInput(value string) string {
+	if utf8.ValidString(value) {
+		clean := true
+		for _, r := range value {
+			if unicode.IsControl(r) {
+				clean = false
+				break
+			}
+		}
+		if clean {
+			return value
+		}
+	}
+	value = strings.ToValidUTF8(value, "\uFFFD")
+	var result strings.Builder
+	result.Grow(len(value))
+	previousCR := false
+	for _, r := range value {
+		switch r {
+		case '\r':
+			result.WriteByte(' ')
+			previousCR = true
+		case '\n':
+			if !previousCR {
+				result.WriteByte(' ')
+			}
+			previousCR = false
+		case '\t':
+			result.WriteByte(' ')
+			previousCR = false
+		default:
+			previousCR = false
+			if !unicode.IsControl(r) {
+				result.WriteRune(r)
+			}
+		}
+	}
+	return result.String()
+}
+
+func limitText(value string, maxBytes int) string {
+	if maxBytes <= 0 || len(value) <= maxBytes {
+		return value
+	}
+	return graphemePrefix(value, maxBytes)
+}
+
+// graphemePrefix uses a negative limit for unlimited input and never cuts an
+// extended grapheme cluster.
+func graphemePrefix(value string, maxBytes int) string {
+	if maxBytes < 0 || len(value) <= maxBytes {
+		return value
+	}
+	end := 0
+	graphemes := uniseg.NewGraphemes(value)
+	for graphemes.Next() {
+		_, next := graphemes.Positions()
+		if next > maxBytes {
+			break
+		}
+		end = next
+	}
+	return value[:end]
+}
+
+func floorBoundary(value string, position int) int {
+	position = min(max(position, 0), len(value))
+	if position == len(value) {
+		return position
+	}
+	boundary := 0
+	graphemes := uniseg.NewGraphemes(value)
+	for graphemes.Next() {
+		from, to := graphemes.Positions()
+		if position < to {
+			if position == to {
+				return to
+			}
+			return from
+		}
+		boundary = to
+	}
+	return boundary
+}
+
+func floorBoundaries(value string, cursor, anchor, offset int) (int, int, int) {
+	positions := [3]int{cursor, anchor, offset}
+	result := [3]int{}
+	maximum := 0
+	for index := range positions {
+		positions[index] = min(max(positions[index], 0), len(value))
+		maximum = max(maximum, positions[index])
+	}
+	graphemes := uniseg.NewGraphemes(value)
+	for graphemes.Next() {
+		_, to := graphemes.Positions()
+		for index, position := range positions {
+			if to <= position {
+				result[index] = to
+			}
+		}
+		if to >= maximum {
+			break
+		}
+	}
+	return result[0], result[1], result[2]
+}
+
+func (t *TextInput) selection() (start, end int) {
+	if t.Cursor < t.Anchor {
+		return t.Cursor, t.Anchor
+	}
+	return t.Anchor, t.Cursor
+}
+
+func ceilBoundary(value string, position int) int {
+	position = min(max(position, 0), len(value))
+	graphemes := uniseg.NewGraphemes(value)
+	for graphemes.Next() {
+		from, to := graphemes.Positions()
+		if position == from {
+			return from
+		}
+		if position < to {
+			return to
+		}
+	}
+	return len(value)
+}
+
+func previousBoundary(value string, position int) int {
+	position = floorBoundary(value, position)
+	previous := 0
+	graphemes := uniseg.NewGraphemes(value)
+	for graphemes.Next() {
+		from, _ := graphemes.Positions()
+		if from >= position {
+			break
+		}
+		previous = from
+	}
+	return previous
+}
+
+func nextBoundary(value string, position int) int {
+	position = floorBoundary(value, position)
+	graphemes := uniseg.NewGraphemes(value)
+	for graphemes.Next() {
+		_, to := graphemes.Positions()
+		if to > position {
+			return to
+		}
+	}
+	return len(value)
+}
+
+func wordLike(value string) bool {
+	for _, r := range value {
+		if r == '_' || unicode.IsLetter(r) || unicode.IsNumber(r) || unicode.IsMark(r) {
+			return true
+		}
+	}
+	return false
+}
+
+func previousWord(value string, position int) int {
+	position = floorBoundary(value, position)
+	start, target := 0, 0
+	graphemes := uniseg.NewGraphemes(value)
+	for graphemes.Next() {
+		_, end := graphemes.Positions()
+		if !graphemes.IsWordBoundary() {
+			continue
+		}
+		if wordLike(value[start:end]) {
+			if start >= position {
+				break
+			}
+			target = start
+		}
+		start = end
+		if start >= position {
+			break
+		}
+	}
+	return target
+}
+
+func nextWord(value string, position int) int {
+	position = floorBoundary(value, position)
+	start := 0
+	graphemes := uniseg.NewGraphemes(value)
+	for graphemes.Next() {
+		_, end := graphemes.Positions()
+		if !graphemes.IsWordBoundary() {
+			continue
+		}
+		if start > position && wordLike(value[start:end]) {
+			return start
+		}
+		start = end
+	}
+	return len(value)
+}
+
+func byteAtCell(value string, offset, cell, width int) int {
+	offset = floorBoundary(value, offset)
+	if cell <= 0 || width <= 0 {
+		return offset
+	}
+	x := 0
+	graphemes := uniseg.NewGraphemes(value[offset:])
+	for graphemes.Next() {
+		from, to := graphemes.Positions()
+		from, to = from+offset, to+offset
+		cells := render.GraphemeWidth(graphemes.Str())
+		if cells == 0 {
+			continue
+		}
+		if x+cells > width {
+			return from
+		}
+		if cell < x+cells {
+			if cell-x >= (cells+1)/2 {
+				return to
+			}
+			return from
+		}
+		x += cells
+		if x >= width {
+			return to
+		}
+	}
+	return len(value)
+}
+
+func textCells(value string) int {
+	width := 0
+	graphemes := uniseg.NewGraphemes(value)
+	for graphemes.Next() {
+		width += render.GraphemeWidth(graphemes.Str())
+	}
+	return width
+}
