+	ctx.mu.Unlock()
+	stale := snapshot{regions: []region{{id: "old", bounds: render.Rect{W: 4, H: 1}, flags: Focusable}}, focus: "old"}
+	ctx.Handle(event.ResizeTo(40, 10))
+	ctx.commit(1, 1, stale)
+	if ctx.Focused("old") || ctx.Focus("old") {
