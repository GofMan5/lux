+package layout
+
+import (
+	"testing"
+
+	"github.com/lux-tui/lux/render"
+)
+
+func TestFlexShrinksAndGrows(t *testing.T) {
+	constraints := []Constraint{{Basis: 20, Min: 8, Grow: 1, Shrink: 1}, {Basis: 40, Min: 12, Grow: 2, Shrink: 2}}
+	areas := Flex(make([]render.Rect, 2), render.Rect{W: 100, H: 10}, Horizontal, 2, constraints...)
+	if areas[0].W+areas[1].W+2 != 100 || areas[1].W <= areas[0].W {
+		t.Fatalf("bad growth: %#v", areas)
+	}
+	areas = Flex(areas, render.Rect{W: 30, H: 10}, Horizontal, 2, constraints...)
+	if areas[0].W+areas[1].W+2 != 30 || areas[0].W < 8 || areas[1].W < 12 {
+		t.Fatalf("bad shrink: %#v", areas)
+	}
+}
+
+func TestClassifyHonorsHeight(t *testing.T) {
+	if got := Classify(render.Rect{W: 200, H: 2}); got != Tiny {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestFlexNeverEscapesTinyArea(t *testing.T) {
+	items := []Constraint{{Basis: 10, Min: 8, Shrink: 1}, {Basis: 10, Min: 8, Shrink: 1}}
+	for _, width := range []int{0, 1, 3} {
+		areas := Flex(make([]render.Rect, 2), render.Rect{W: width, H: 1}, Horizontal, 10, items...)
+		for _, area := range areas {
+			if area.X < 0 || area.W < 0 || area.Right() > width {
+				t.Fatalf("width %d escaped: %#v", width, areas)
+			}
+		}
+	}
+}
diff --git a/motion/motion.go b/motion/motion.go
new file mode 100644
index 0000000..c7cad47
--- /dev/null
+++ b/motion/motion.go
@@ -0,0 +1,88 @@
+// Package motion contains allocation-free, absolute-time animation primitives.
+package motion
+
+import (
+	"math"
+	"time"
+)
+
+// Ease maps normalized time to normalized progress.
+type Ease func(float64) float64
+
+func Linear(t float64) float64 { return clamp01(t) }
+
+func InOutCubic(t float64) float64 {
+	t = clamp01(t)
+	if t < .5 {
+		return 4 * t * t * t
+	}
+	x := -2*t + 2
+	return 1 - x*x*x/2
+}
+
+func OutCubic(t float64) float64 {
+	x := 1 - clamp01(t)
+	return 1 - x*x*x
+}
+
+func OutBack(t float64) float64 {
+	t = clamp01(t)
+	const c1 = 1.70158
+	const c3 = c1 + 1
+	x := t - 1
+	return 1 + c3*x*x*x + c1*x*x
+}
+
+// Tween samples a value from From to To against the monotonic component of time.Time.
+type Tween struct {
+	From     float64
+	To       float64
+	Start    time.Time
+	Duration time.Duration
+	Ease     Ease
+}
+
+// Value returns the current value and whether the tween has reached its end.
+func (t Tween) Value(now time.Time) (float64, bool) {
+	if t.Duration <= 0 || !now.Before(t.Start.Add(t.Duration)) {
+		return t.To, true
+	}
+	if now.Before(t.Start) {
+		return t.From, false
+	}
+	progress := float64(now.Sub(t.Start)) / float64(t.Duration)
+	ease := t.Ease
+	if ease == nil {
+		ease = Linear
+	}
+	return t.From + (t.To-t.From)*ease(progress), false
+}
+
+// Spring is an analytic, critically damped spring. It is sampled by absolute
+// time, so delayed frames skip stale visual states instead of replaying them.
+type Spring struct {
+	From     float64
+	To       float64
+	Velocity float64
+	Start    time.Time
+	Response time.Duration
+}
+
+// Value returns position and velocity. Response is approximately the time to
+// settle; non-positive response snaps to the target.
+func (s Spring) Value(now time.Time) (position, velocity float64) {
+	if s.Response <= 0 || !now.After(s.Start) {
+		if s.Response <= 0 {
+			return s.To, 0
+		}
+		return s.From, s.Velocity
+	}
+	t := now.Sub(s.Start).Seconds()
+	omega := 4.6 / s.Response.Seconds()
+	delta := s.From - s.To
+	c := s.Velocity + omega*delta
+	exp := math.Exp(-omega * t)
+	return s.To + (delta+c*t)*exp, (s.Velocity - omega*c*t) * exp
+}
+
+func clamp01(value float64) float64 { return min(max(value, 0), 1) }
