@@ -0,0 +1,27 @@
+package motion
+
+import (
+	"math"
+	"testing"
+	"time"
+)
+
+func TestTweenSkipsLateFrames(t *testing.T) {
+	start := time.Now()
+	tween := Tween{From: 10, To: 20, Start: start, Duration: time.Second, Ease: InOutCubic}
+	if value, done := tween.Value(start.Add(2 * time.Second)); value != 20 || !done {
+		t.Fatalf("late tween = %v, %v", value, done)
+	}
+	if value, _ := tween.Value(start.Add(500 * time.Millisecond)); math.Abs(value-15) > 1e-9 {
+		t.Fatalf("midpoint = %v", value)
+	}
+}
+
+func TestSpringConverges(t *testing.T) {
+	start := time.Now()
+	spring := Spring{From: 0, To: 1, Start: start, Response: 300 * time.Millisecond}
+	position, velocity := spring.Value(start.Add(2 * time.Second))
+	if math.Abs(position-1) > .001 || math.Abs(velocity) > .01 {
+		t.Fatalf("spring did not converge: position=%v velocity=%v", position, velocity)
+	}
+}
diff --git a/render/buffer.go b/render/buffer.go
new file mode 100644
index 0000000..32f7303
--- /dev/null
+++ b/render/buffer.go
@@ -0,0 +1,339 @@
+package render
+
+// Change is one changed cell in a frame diff.
+type Change struct {
+	X    int
+	Y    int
+	Cell Cell
+}
+
+// Buffer owns a rectangular, row-major grid of canonical cells.
+type Buffer struct {
+	width  int
+	height int
+	cells  []Cell
+}
+
+// NewBuffer returns a blank buffer. Negative dimensions are treated as zero.
+func NewBuffer(width, height int) *Buffer {
+	buffer := &Buffer{}
+	buffer.Resize(width, height)
+	return buffer
+}
+
+// Size returns the buffer dimensions in cells.
+func (b *Buffer) Size() (width, height int) {
+	if b == nil {
+		return 0, 0
+	}
+	return b.width, b.height
+}
+
+// Bounds returns the whole buffer rectangle.
+func (b *Buffer) Bounds() Rect {
+	width, height := b.Size()
+	return Bounds(width, height)
+}
+
+// Len returns the number of cells, including wide-grapheme continuations.
+func (b *Buffer) Len() int {
+	if b == nil {
+		return 0
+	}
+	return len(b.cells)
+}
+
+// Cell returns a cell or the zero Cell when the coordinates are outside b.
+// CellOK distinguishes an outside cell from a continuation cell.
+func (b *Buffer) Cell(x, y int) Cell {
+	cell, _ := b.CellOK(x, y)
+	return cell
+}
+
+// CellOK returns a cell and whether the coordinates are inside b.
+func (b *Buffer) CellOK(x, y int) (Cell, bool) {
+	if b == nil || x < 0 || y < 0 || x >= b.width || y >= b.height {
+		return Cell{}, false
+	}
+	return b.cells[y*b.width+x], true
+}
+
+// CellAt returns the row-major cell at index, or the zero Cell when outside b.
+func (b *Buffer) CellAt(index int) Cell {
+	if b == nil || index < 0 || index >= len(b.cells) {
+		return Cell{}
+	}
+	return b.cells[index]
+}
+
+// EqualCell compares one coordinate in two buffers.
+func (b *Buffer) EqualCell(other *Buffer, x, y int) bool {
+	left, leftOK := b.CellOK(x, y)
+	right, rightOK := other.CellOK(x, y)
+	return leftOK == rightOK && (!leftOK || left == right)
+}
+
+// EqualIndex compares one row-major index in two buffers.
+func (b *Buffer) EqualIndex(other *Buffer, index int) bool {
+	if b == nil || other == nil || index < 0 || index >= len(b.cells) || index >= len(other.cells) {
+		return b == nil && other == nil
+	}
+	return b.cells[index] == other.cells[index]
+}
+
+// Equal reports whether two buffers have identical dimensions and cells.
+func (b *Buffer) Equal(other *Buffer) bool {
+	if b == nil || other == nil {
+		return b == nil && other == nil
+	}
+	if b.width != other.width || b.height != other.height {
+		return false
+	}
+	for index := range b.cells {
+		if b.cells[index] != other.cells[index] {
+			return false
+		}
+	}
+	return true
+}
+
+// Clone returns an independent copy of b.
+func (b *Buffer) Clone() *Buffer {
+	if b == nil {
+		return nil
+	}
+	clone := &Buffer{width: b.width, height: b.height, cells: make([]Cell, len(b.cells))}
+	copy(clone.cells, b.cells)
+	return clone
+}
+
+// CopyFrom replaces b with an independent copy of source.
+func (b *Buffer) CopyFrom(source *Buffer) {
+	if b == nil || b == source {
+		return
+	}
+	if source == nil {
+		b.width, b.height, b.cells = 0, 0, nil
+		return
+	}
+	b.width, b.height = source.width, source.height
+	b.cells = append(b.cells[:0], source.cells...)
+}
+
+// Resize changes the dimensions while preserving their overlapping top-left
+// area. A wide grapheme clipped by the new edge is replaced with blanks.
+func (b *Buffer) Resize(width, height int) bool {
+	if b == nil {
+		return false
+	}
+	width, height = max(width, 0), max(height, 0)
+	if width == b.width && height == b.height {
+		return false
+	}
+	if height != 0 && width > int(^uint(0)>>1)/height {
+		panic("render: buffer dimensions overflow")
+	}
+	cells := make([]Cell, width*height)
+	fillCells(cells, BlankCell)
+	copyWidth, copyHeight := min(width, b.width), min(height, b.height)
+	for y := 0; y < copyHeight; y++ {
+		copy(cells[y*width:y*width+copyWidth], b.cells[y*b.width:y*b.width+copyWidth])
+	}
+	b.width, b.height, b.cells = width, height, cells
+	b.repair()
+	return true
+}
+
+// Reset clears b to default-style blanks without reallocating.
+func (b *Buffer) Reset() { b.Clear(Style{}) }
+
+// Clear fills b with blank cells using style.
+func (b *Buffer) Clear(style Style) {
+	if b == nil {
+		return
+	}
+	cell := BlankCell
+	cell.Style = style
+	fillCells(b.cells, cell)
+}
+
+// AppendDiff appends cells that differ from previous. If dimensions differ,
+// every cell in b is appended; terminal adapters should resize first.
+func (b *Buffer) AppendDiff(changes []Change, previous *Buffer) []Change {
+	if b == nil {
+		return changes
+	}
+	all := previous == nil || b.width != previous.width || b.height != previous.height
+	for index, cell := range b.cells {
+		if all || cell != previous.cells[index] {
+			changes = append(changes, Change{X: index % b.width, Y: index / b.width, Cell: cell})
+		}
+	}
+	return changes
+}
+
+// Diff returns cells that differ from previous.
+func (b *Buffer) Diff(previous *Buffer) []Change { return b.AppendDiff(nil, previous) }
+
+func (b *Buffer) put(x, y int, grapheme string, width int, style Style) bool {
+	if b == nil || y < 0 || y >= b.height || x < 0 || x >= b.width || width < 1 || width > 2 || x+width > b.width {
+		return false
+	}
+	b.eraseAt(x, y)
+	if width == 2 {
+		b.eraseAt(x+1, y)
+	}
+	index := y*b.width + x
+	b.cells[index] = Cell{Grapheme: grapheme, Width: uint8(width), Style: style}
+	if width == 2 {
+		b.cells[index+1] = Cell{Width: 0, Style: style}
+	}
+	return true
+}
+
+func (b *Buffer) replacementFits(clip Rect, x, y, width int) bool {
+	left, right := x, x+width-1
+	for column := left; column <= right; column++ {
+		cell, ok := b.CellOK(column, y)
+		if !ok {
+			return false
+		}
+		switch cell.Width {
+		case 0:
+			left = min(left, column-1)
+		case 2:
+			right = max(right, column+1)
+		}
+	}
+	return clip.Contains(left, y) && clip.Contains(right, y)
+}
+
+func (b *Buffer) appendCombining(x, y int, grapheme string) bool {
+	if b == nil || x < 0 || y < 0 || x >= b.width || y >= b.height || grapheme == "" {
+		return false
+	}
+	index := y*b.width + x
+	if b.cells[index].Width == 0 {
+		if x == 0 {
+			return false
+		}
+		index--
+	}
+	if b.cells[index].Width != 1 && b.cells[index].Width != 2 {
+		return false
+	}
+	b.cells[index].Grapheme += grapheme
+	return true
+}
+
+func (b *Buffer) eraseAt(x, y int) {
+	if b == nil || x < 0 || y < 0 || x >= b.width || y >= b.height {
+		return
+	}
+	index := y*b.width + x
+	switch b.cells[index].Width {
+	case 0:
+		b.cells[index] = BlankCell
+		if x > 0 && b.cells[index-1].Width == 2 {
+			b.cells[index-1] = BlankCell
+		}
+	case 2:
+		b.cells[index] = BlankCell
+		if x+1 < b.width {
+			b.cells[index+1] = BlankCell
+		}
+	default:
+		b.cells[index] = BlankCell
+	}
+}
+
+func (b *Buffer) repair() {
+	for y := 0; y < b.height; y++ {
+		for x := 0; x < b.width; x++ {
+			index := y*b.width + x
+			switch b.cells[index].Width {
+			case 1:
+				if b.cells[index].Grapheme == "" {
+					b.cells[index].Grapheme = " "
+				}
+			case 2:
+				if b.cells[index].Grapheme == "" || x+1 == b.width {
+					b.cells[index] = BlankCell
+					continue
+				}
+				b.cells[index+1] = Cell{Width: 0, Style: b.cells[index].Style}
+				x++
+			default:
+				b.cells[index] = BlankCell
+			}
+		}
+	}
+}
+
+func fillCells(cells []Cell, cell Cell) {
+	for index := range cells {
+		cells[index] = cell
+	}
+}
+
+// DoubleBuffer keeps the last presented frame and the frame being drawn.
+type DoubleBuffer struct {
+	front *Buffer
+	back  *Buffer
+}
+
+// NewDoubleBuffer returns two blank buffers with matching dimensions.
+func NewDoubleBuffer(width, height int) *DoubleBuffer {
+	return &DoubleBuffer{front: NewBuffer(width, height), back: NewBuffer(width, height)}
+}
+
+// Front is the last presented frame.
+func (d *DoubleBuffer) Front() *Buffer {
+	if d == nil {
+		return nil
+	}
+	return d.front
+}
+
+// Back is the frame applications draw into.
+func (d *DoubleBuffer) Back() *Buffer {
+	if d == nil {
+		return nil
+	}
+	return d.back
+}
+
+// AppendChanges appends cells needed to turn Front into Back.
+func (d *DoubleBuffer) AppendChanges(changes []Change) []Change {
+	if d == nil {
+		return changes
+	}
+	return d.back.AppendDiff(changes, d.front)
+}
+
+// Changes returns cells needed to turn Front into Back.
+func (d *DoubleBuffer) Changes() []Change { return d.AppendChanges(nil) }
+
+// Swap marks Back as presented. The new Back retains the older frame so a
+// caller can either reset it or redraw only changed regions.
+func (d *DoubleBuffer) Swap() {
+	if d != nil {
+		d.front, d.back = d.back, d.front
+	}
+}
+
+// Resize resizes both frames while preserving overlapping content.
+func (d *DoubleBuffer) Resize(width, height int) {
+	if d != nil {
+		d.front.Resize(width, height)
+		d.back.Resize(width, height)
+	}
+}
+
+// Reset clears both frames without reallocating.
+func (d *DoubleBuffer) Reset() {
+	if d != nil {
+		d.front.Reset()
+		d.back.Reset()
+	}
+}
diff --git a/render/canvas.go b/render/canvas.go
new file mode 100644
index 0000000..9774659
--- /dev/null
+++ b/render/canvas.go
@@ -0,0 +1,237 @@
+package render
+
+import (
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/rivo/uniseg"
+)
+
+// Border defines the eight graphemes used to draw a box.
+type Border struct {
+	TopLeft     string
+	Top         string
+	TopRight    string
+	Left        string
+	Right       string
+	BottomLeft  string
+	Bottom      string
+	BottomRight string
+}
+
+var (
+	SingleBorder  = Border{"┌", "─", "┐", "│", "│", "└", "─", "┘"}
+	RoundedBorder = Border{"╭", "─", "╮", "│", "│", "╰", "─", "╯"}
+	DoubleBorder  = Border{"╔", "═", "╗", "║", "║", "╚", "═", "╝"}
+	HeavyBorder   = Border{"┏", "━", "┓", "┃", "┃", "┗", "━", "┛"}
+	ASCIIBorder   = Border{"+", "-", "+", "|", "|", "+", "-", "+"}
+)
+
+// Canvas draws local coordinates into a clipped Buffer view.
+type Canvas struct {
+	buffer        *Buffer
+	originX       int
+	originY       int
+	width, height int
+	clip          Rect
+}
+
+// NewCanvas returns a canvas covering buffer.
+func NewCanvas(buffer *Buffer) *Canvas {
+	width, height := buffer.Size()
+	return &Canvas{buffer: buffer, width: width, height: height, clip: Bounds(width, height)}
+}
+
+// Buffer returns the canvas's underlying buffer.
+func (c *Canvas) Buffer() *Buffer {
+	if c == nil {
+		return nil
+	}
+	return c.buffer
+}
+
+// Size returns the canvas's local dimensions.
+func (c *Canvas) Size() (width, height int) {
+	if c == nil {
+		return 0, 0
+	}
+	return c.width, c.height
+}
+
+// Bounds returns the local canvas rectangle.
+func (c *Canvas) Bounds() Rect {
+	width, height := c.Size()
+	return Bounds(width, height)
+}
+
+// Subview returns a canvas whose origin is rect's clipped top-left corner.
+func (c *Canvas) Subview(rect Rect) *Canvas {
+	if c == nil {
+		return &Canvas{}
+	}
+	local := rect.Intersect(c.Bounds())
+	absolute := Rect{X: c.originX + local.X, Y: c.originY + local.Y, W: local.W, H: local.H}
+	return &Canvas{
+		buffer:  c.buffer,
+		originX: absolute.X,
+		originY: absolute.Y,
+		width:   local.W,
+		height:  local.H,
+		clip:    absolute.Intersect(c.clip),
+	}
+}
+
+// Clip restricts drawing to rect while preserving c's coordinate system.
+func (c *Canvas) Clip(rect Rect) *Canvas {
+	if c == nil {
+		return &Canvas{}
+	}
+	local := rect.Intersect(c.Bounds())
+	absolute := Rect{X: c.originX + local.X, Y: c.originY + local.Y, W: local.W, H: local.H}
+	clipped := *c
+	clipped.clip = c.clip.Intersect(absolute)
+	return &clipped
+}
+
+// Clear fills the canvas with styled blanks.
+func (c *Canvas) Clear(style Style) { c.Fill(c.Bounds(), " ", style) }
+
+// Fill tiles rect with the first grapheme in grapheme. A wide grapheme leaves
+// a styled blank when a final odd cell cannot contain it.
+func (c *Canvas) Fill(rect Rect, grapheme string, style Style) {
+	if c == nil || c.buffer == nil {
+		return
+	}
+	grapheme, width := firstGrapheme(grapheme)
+	if width == 0 || !printable(grapheme) {
+		return
+	}
+	rect = rect.Intersect(c.Bounds())
+	for y := rect.Y; y < rect.Bottom(); y++ {
+		for x := rect.X; x < rect.Right(); x += width {
+			if x+width <= rect.Right() {
+				c.Put(x, y, grapheme, style)
+			} else {
+				c.Put(x, y, " ", style)
+			}
+		}
+	}
+}
+
+// Put writes the first grapheme at a local coordinate and returns its cursor
+// advance. Wide graphemes are never split by a canvas or clipping edge.
+func (c *Canvas) Put(x, y int, grapheme string, style Style) int {
+	grapheme, width := firstGrapheme(grapheme)
+	if c == nil || c.buffer == nil || grapheme == "" || !printable(grapheme) {
+		return width
+	}
+	if width == 0 {
+		c.appendCombining(x, y, grapheme)
+		return 0
+	}
+	if y < 0 || y >= c.height || x < 0 || x+width > c.width {
+		return width
+	}
+	absoluteX, absoluteY := c.originX+x, c.originY+y
+	if !c.clip.Contains(absoluteX, absoluteY) || !c.clip.Contains(absoluteX+width-1, absoluteY) {
+		return width
+	}
+	if !c.buffer.replacementFits(c.clip, absoluteX, absoluteY, width) {
+		return width
+	}
+	c.buffer.put(absoluteX, absoluteY, grapheme, width, style)
+	return width
+}
+
+// Text draws text with grapheme-aware widths, newlines, carriage returns and
+// four-column tab stops. It returns the widest input line.
+func (c *Canvas) Text(x, y int, text string, style Style) int {
+	startX, cursorX, cursorY, widest := x, x, y, 0
+	graphemes := uniseg.NewGraphemes(text)
+	for graphemes.Next() {
+		grapheme := graphemes.Str()
+		switch grapheme {
+		case "\n", "\r\n":
+			widest = max(widest, cursorX-startX)
+			cursorX, cursorY = startX, cursorY+1
+		case "\r":
+			widest = max(widest, cursorX-startX)
+			cursorX = startX
+		case "\t":
+			spaces := 4 - (cursorX-startX)%4
+			for range spaces {
+				c.Put(cursorX, cursorY, " ", style)
+				cursorX++
+			}
+		default:
+			if !printable(grapheme) {
+				continue
+			}
+			width := terminalWidth(grapheme)
+			if width == 0 {
+				c.appendCombining(cursorX, cursorY, grapheme)
+			} else {
+				c.Put(cursorX, cursorY, grapheme, style)
+				cursorX += width
+			}
+		}
+	}
+	return max(widest, cursorX-startX)
+}
+
+// Border draws a border inside rect and degrades to a line or one cell for
+// tiny rectangles.
+func (c *Canvas) Border(rect Rect, border Border, style Style) {
+	if c == nil || rect.W <= 0 || rect.H <= 0 {
+		return
+	}
+	if rect.W == 1 && rect.H == 1 {
+		c.Put(rect.X, rect.Y, border.TopLeft, style)
+		return
+	}
+	if rect.H == 1 {
+		c.Fill(rect, border.Top, style)
+		return
+	}
+	if rect.W == 1 {
+		c.Fill(rect, border.Left, style)
+		return
+	}
+	c.Put(rect.X, rect.Y, border.TopLeft, style)
+	c.Put(rect.Right()-1, rect.Y, border.TopRight, style)
+	c.Put(rect.X, rect.Bottom()-1, border.BottomLeft, style)
+	c.Put(rect.Right()-1, rect.Bottom()-1, border.BottomRight, style)
+	if rect.W > 2 {
+		c.Fill(Rect{X: rect.X + 1, Y: rect.Y, W: rect.W - 2, H: 1}, border.Top, style)
+		c.Fill(Rect{X: rect.X + 1, Y: rect.Bottom() - 1, W: rect.W - 2, H: 1}, border.Bottom, style)
+	}
+	if rect.H > 2 {
+		c.Fill(Rect{X: rect.X, Y: rect.Y + 1, W: 1, H: rect.H - 2}, border.Left, style)
+		c.Fill(Rect{X: rect.Right() - 1, Y: rect.Y + 1, W: 1, H: rect.H - 2}, border.Right, style)
+	}
+}
+
+func (c *Canvas) appendCombining(x, y int, grapheme string) {
+	if c == nil || c.buffer == nil || y < 0 || y >= c.height || x <= 0 || x > c.width {
+		return
+	}
+	absoluteX, absoluteY := c.originX+x-1, c.originY+y
+	cell, ok := c.buffer.CellOK(absoluteX, absoluteY)
+	if !ok {
+		return
+	}
+	if cell.Width == 0 {
+		absoluteX--
+	}
+	if c.clip.Contains(absoluteX, absoluteY) {
+		c.buffer.appendCombining(absoluteX, absoluteY, grapheme)
+	}
+}
+
+func printable(grapheme string) bool {
+	if !utf8.ValidString(grapheme) {
+		return false
+	}
+	r, _ := utf8.DecodeRuneInString(grapheme)
+	return !unicode.IsControl(r)
+}
diff --git a/render/render_test.go b/render/render_test.go
new file mode 100644
index 0000000..5645e58
--- /dev/null
+++ b/render/render_test.go
@@ -0,0 +1,181 @@
+package render
+
+import "testing"
+
+func TestCanvasTextPreservesGraphemesAndRepairsWideCells(t *testing.T) {
+	buffer := NewBuffer(8, 2)
+	canvas := NewCanvas(buffer)
+	style := Style{Foreground: RGBColor(12, 34, 56), Attrs: AttrBold | AttrUnderline}
+
+	if width := canvas.Text(0, 0, "A界e\u0301🙂", style); width != 6 {
+		t.Fatalf("Text width = %d, want 6", width)
+	}
+	want := []Cell{
+		{Grapheme: "A", Width: 1, Style: style},
+		{Grapheme: "界", Width: 2, Style: style},
+		{Width: 0, Style: style},
+		{Grapheme: "é", Width: 1, Style: style},
+		{Grapheme: "🙂", Width: 2, Style: style},
+		{Width: 0, Style: style},
+	}
+	for x, expected := range want {
+		if got := buffer.Cell(x, 0); got != expected {
+			t.Errorf("Cell(%d, 0) = %#v, want %#v", x, got, expected)
+		}
+	}
+
+	canvas.Put(2, 0, "x", Style{})
+	if got := buffer.Cell(1, 0); got != BlankCell {
+		t.Errorf("overwritten wide lead = %#v, want blank", got)
+	}
+	if got := buffer.Cell(2, 0); got.Grapheme != "x" || got.Width != 1 {
+		t.Errorf("wide continuation replacement = %#v", got)
+	}
+
+	canvas.Put(4, 0, "y", Style{})
+	if got := buffer.Cell(5, 0); got != BlankCell {
+		t.Errorf("wide trailing cell = %#v after lead overwrite, want blank", got)
+	}
+}
+
+func TestCanvasClippingAndSubview(t *testing.T) {
+	buffer := NewBuffer(7, 3)
+	canvas := NewCanvas(buffer)
+	canvas.Fill(canvas.Bounds(), ".", Style{})
+	view := canvas.Subview(Rect{X: 2, Y: 1, W: 3, H: 2})
+	view.Fill(view.Bounds(), "x", Style{})
+
+	for y := range 3 {
+		for x := range 7 {
+			want := "."
+			if x >= 2 && x < 5 && y >= 1 {
+				want = "x"
+			}
+			if got := buffer.Cell(x, y).Grapheme; got != want {
+				t.Fatalf("Cell(%d, %d) = %q, want %q", x, y, got, want)
+			}
+		}
+	}
+
+	canvas.Put(1, 0, "界", Style{})
+	canvas.Clip(Rect{X: 2, Y: 0, W: 2, H: 1}).Put(2, 0, "z", Style{})
+	if got := buffer.Cell(1, 0); got.Grapheme != "界" || got.Width != 2 {
+		t.Fatalf("clip split a wide cell: %#v", got)
+	}
+	if got := buffer.Cell(2, 0); !got.IsContinuation() {
+		t.Fatalf("wide continuation was replaced across clip: %#v", got)
+	}
+}
+
+func TestBufferResizeCloneDiffAndReset(t *testing.T) {
+	style := Style{Background: IndexedColor(42), Attrs: AttrItalic}
+	buffer := NewBuffer(4, 2)
+	canvas := NewCanvas(buffer)
+	canvas.Put(2, 0, "界", style)
+	clone := buffer.Clone()
+
+	if !clone.Equal(buffer) {
+		t.Fatal("Clone differs from source")
+	}
+	clone.Resize(3, 2)
+	if got := clone.Cell(2, 0); got != BlankCell {
+		t.Fatalf("Resize retained clipped wide lead: %#v", got)
+	}
+	if got := buffer.Cell(2, 0); got.Grapheme != "界" {
+		t.Fatal("Clone mutated source")
+	}
+
+	copyBuffer := NewBuffer(1, 1)
+	copyBuffer.CopyFrom(buffer)
+	NewCanvas(copyBuffer).Put(0, 1, "x", style)
+	changes := copyBuffer.Diff(buffer)
+	if len(changes) != 1 || changes[0].X != 0 || changes[0].Y != 1 || changes[0].Cell.Grapheme != "x" {
+		t.Fatalf("Diff = %#v, want one changed cell", changes)
+	}
+	copyBuffer.Reset()
+	for index := range copyBuffer.Len() {
+		if got := copyBuffer.CellAt(index); got != BlankCell {
+			t.Fatalf("CellAt(%d) after Reset = %#v", index, got)
+		}
+	}
+}
+
+func TestBorderAndResponsiveRect(t *testing.T) {
+	buffer := NewBuffer(5, 3)
+	canvas := NewCanvas(buffer)
+	canvas.Border(canvas.Bounds(), RoundedBorder, Style{})
+	if got := buffer.Cell(0, 0).Grapheme; got != "╭" {
+		t.Fatalf("top-left = %q", got)
+	}
+	if got := buffer.Cell(4, 2).Grapheme; got != "╯" {
+		t.Fatalf("bottom-right = %q", got)
+	}
+
+	left, rest := (Rect{X: 2, Y: 3, W: 5, H: 4}).SplitLeft(99)
+	if left != (Rect{X: 2, Y: 3, W: 5, H: 4}) || !rest.Empty() {
+		t.Fatalf("clamped SplitLeft = %#v, %#v", left, rest)
+	}
+	top, bottom := rest.SplitTop(2)
+	if !top.Empty() || !bottom.Empty() {
+		t.Fatalf("empty split = %#v, %#v", top, bottom)
+	}
+}
+
+func TestDoubleBufferLifecycle(t *testing.T) {
+	double := NewDoubleBuffer(3, 1)
+	NewCanvas(double.Back()).Text(0, 0, "ok", Style{})
+	changes := double.Changes()
+	if len(changes) != 2 {
+		t.Fatalf("Changes length = %d, want 2", len(changes))
+	}
+	double.Swap()
+	if changes := double.Changes(); len(changes) != 2 {
+		t.Fatalf("Changes after swap = %d, want two cells reverting older back frame", len(changes))
+	}
+	double.Back().CopyFrom(double.Front())
+	if changes := double.Changes(); len(changes) != 0 {
+		t.Fatalf("Changes after CopyFrom = %d, want 0", len(changes))
+	}
+}
+
+func TestWidthsAndTextControls(t *testing.T) {
+	if got := GraphemeWidth("👨‍👩‍👧‍👦tail"); got != 2 {
+		t.Fatalf("family emoji width = %d, want 2", got)
+	}
+	if got := TextWidth("ab\n界x"); got != 3 {
+		t.Fatalf("multiline width = %d, want 3", got)
+	}
+	buffer := NewBuffer(4, 1)
+	width := NewCanvas(buffer).Text(0, 0, "a\x1bb", Style{})
+	if width != 2 || buffer.Cell(0, 0).Grapheme != "a" || buffer.Cell(1, 0).Grapheme != "b" {
+		t.Fatalf("control handling width=%d cells=%#v", width, buffer.cells)
+	}
+	if got := TextWidth("abc\rx"); got != 3 {
+		t.Fatalf("carriage-return width = %d, want 3", got)
+	}
+}
+
+func BenchmarkCanvasFrame(b *testing.B) {
+	buffer := NewBuffer(120, 40)
+	canvas := NewCanvas(buffer)
+	style := Style{Foreground: RGBColor(220, 225, 235), Background: RGBColor(20, 24, 32)}
+	line := "Lux TUI · smooth 界面 · 60 FPS · 👨‍👩‍👧‍👦"
+	b.ReportAllocs()
+	for range b.N {
+		canvas.Clear(style)
+		canvas.Border(canvas.Bounds(), RoundedBorder, style)
+		for y := 1; y < 39; y++ {
+			canvas.Text(2, y, line, style)
+		}
+	}
+}
+
+func BenchmarkBufferDiffNoChanges(b *testing.B) {
+	front := NewBuffer(160, 50)
+	back := front.Clone()
+	changes := make([]Change, 0, 32)
+	b.ReportAllocs()
+	for range b.N {
+		changes = back.AppendDiff(changes[:0], front)
+	}
+}
diff --git a/render/types.go b/render/types.go
new file mode 100644
index 0000000..61a8c1e
--- /dev/null
+++ b/render/types.go
@@ -0,0 +1,189 @@
+// Package render provides a small, terminal-independent cell renderer.
+package render
+
+import "github.com/rivo/uniseg"
+
+// ColorMode describes how a terminal color is encoded.
+type ColorMode uint8
+
+const (
+	ColorDefault ColorMode = iota
+	ColorANSI
+	ColorIndexed
+	ColorRGB
+)
+
+// Color is a comparable terminal color. Value contains an ANSI/index value or
+// packed 0xRRGGBB for ColorRGB.
+type Color struct {
+	Mode  ColorMode
+	Value uint32
+}
+
+// ANSIColor returns one of the terminal's first 16 colors.
+func ANSIColor(index uint8) Color { return Color{Mode: ColorANSI, Value: uint32(index & 15)} }
+
+// IndexedColor returns a color from the terminal's 256-color palette.
+func IndexedColor(index uint8) Color { return Color{Mode: ColorIndexed, Value: uint32(index)} }
+
+// RGBColor returns a 24-bit terminal color.
+func RGBColor(red, green, blue uint8) Color {
+	return Color{Mode: ColorRGB, Value: uint32(red)<<16 | uint32(green)<<8 | uint32(blue)}
+}
+
+// RGB returns the color channels and whether c is an RGB color.
+func (c Color) RGB() (red, green, blue uint8, ok bool) {
+	if c.Mode != ColorRGB {
+		return 0, 0, 0, false
+	}
+	return uint8(c.Value >> 16), uint8(c.Value >> 8), uint8(c.Value), true
+}
+
+// Attr is a bit set of terminal text attributes.
+type Attr uint16
+
+const (
+	AttrBold Attr = 1 << iota
+	AttrDim
+	AttrItalic
+	AttrUnderline
+	AttrBlink
+	AttrReverse
+	AttrHidden
+	AttrStrike
+)
+
+// Style is deliberately comparable so cell diffs need no allocation.
+type Style struct {
+	Foreground Color
+	Background Color
+	Attrs      Attr
+}
+
+// Has reports whether all attributes are present.
+func (s Style) Has(attrs Attr) bool { return s.Attrs&attrs == attrs }
+
+// Cell is one terminal grid cell. Width is 1 or 2 for a grapheme's leading
+// cell and 0 for the continuation of a width-2 grapheme.
+type Cell struct {
+	Grapheme string
+	Width    uint8
+	Style    Style
+}
+
+// BlankCell is the canonical empty terminal cell.
+var BlankCell = Cell{Grapheme: " ", Width: 1}
+
+// IsContinuation reports whether c is the trailing cell of a wide grapheme.
+func (c Cell) IsContinuation() bool { return c.Width == 0 }
+
+// Rect is a half-open rectangle: [X,X+W) by [Y,Y+H).
+type Rect struct {
+	X int
+	Y int
+	W int
+	H int
+}
+
+// Bounds returns a rectangle rooted at zero. Negative dimensions become zero.
+func Bounds(width, height int) Rect {
+	if width < 0 {
+		width = 0
+	}
+	if height < 0 {
+		height = 0
+	}
+	return Rect{W: width, H: height}
+}
+
+// Right returns the exclusive right edge.
+func (r Rect) Right() int { return r.X + max(r.W, 0) }
+
+// Bottom returns the exclusive bottom edge.
+func (r Rect) Bottom() int { return r.Y + max(r.H, 0) }
+
+// Empty reports whether r has no cells.
+func (r Rect) Empty() bool { return r.W <= 0 || r.H <= 0 }
+
+// Contains reports whether a cell is inside r.
+func (r Rect) Contains(x, y int) bool {
+	return r.W > 0 && r.H > 0 && x >= r.X && x < r.X+r.W && y >= r.Y && y < r.Y+r.H
+}
+
+// Intersect returns the common area of r and other.
+func (r Rect) Intersect(other Rect) Rect {
+	x1, y1 := max(r.X, other.X), max(r.Y, other.Y)
+	x2, y2 := min(r.Right(), other.Right()), min(r.Bottom(), other.Bottom())
+	if x2 <= x1 || y2 <= y1 {
+		return Rect{X: x1, Y: y1}
+	}
+	return Rect{X: x1, Y: y1, W: x2 - x1, H: y2 - y1}
+}
+
+// Inset shrinks r on all sides, clamping at its center.
+func (r Rect) Inset(horizontal, vertical int) Rect {
+	if horizontal < 0 {
+		horizontal = 0
+	}
+	if vertical < 0 {
+		vertical = 0
+	}
+	horizontal = min(horizontal, max(r.W, 0)/2)
+	vertical = min(vertical, max(r.H, 0)/2)
+	return Rect{X: r.X + horizontal, Y: r.Y + vertical, W: max(r.W, 0) - 2*horizontal, H: max(r.H, 0) - 2*vertical}
+}
+
+// SplitLeft splits r at a clamped column, which makes fixed sidebars degrade
+// cleanly in narrow terminals.
+func (r Rect) SplitLeft(width int) (left, rest Rect) {
+	width = min(max(width, 0), max(r.W, 0))
+	return Rect{X: r.X, Y: r.Y, W: width, H: max(r.H, 0)},
+		Rect{X: r.X + width, Y: r.Y, W: max(r.W, 0) - width, H: max(r.H, 0)}
+}
+
+// SplitTop splits r at a clamped row.
+func (r Rect) SplitTop(height int) (top, rest Rect) {
+	height = min(max(height, 0), max(r.H, 0))
+	return Rect{X: r.X, Y: r.Y, W: max(r.W, 0), H: height},
+		Rect{X: r.X, Y: r.Y + height, W: max(r.W, 0), H: max(r.H, 0) - height}
+}
+
+// GraphemeWidth returns the terminal width of the first grapheme in text.
+// Terminal cells support at most two columns, so larger library results clamp.
+func GraphemeWidth(text string) int {
+	_, width := firstGrapheme(text)
+	return width
+}
+
+// TextWidth returns the widest line in text in terminal cells.
+func TextWidth(text string) int {
+	line, widest := 0, 0
+	graphemes := uniseg.NewGraphemes(text)
+	for graphemes.Next() {
+		grapheme := graphemes.Str()
+		switch grapheme {
+		case "\n", "\r\n":
+			widest = max(widest, line)
+			line = 0
+		case "\r":
+			widest = max(widest, line)
+			line = 0
+		case "\t":
+			line += 4 - line%4
+		default:
+			line += terminalWidth(grapheme)
+		}
+	}
+	return max(widest, line)
+}
+
+func firstGrapheme(text string) (string, int) {
+	graphemes := uniseg.NewGraphemes(text)
+	if !graphemes.Next() {
+		return "", 0
+	}
+	grapheme := graphemes.Str()
+	return grapheme, terminalWidth(grapheme)
+}
+
+func terminalWidth(grapheme string) int { return min(max(uniseg.StringWidth(grapheme), 0), 2) }
