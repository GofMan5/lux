+	Background   Color
+	DefaultColor Color
+	Attrs        render.Attr
+	// CellAspect is terminal cell width divided by height. Zero defaults to .5.
+	CellAspect float64
+	// Ramp is an optional one-column, dark-to-bright monochrome ramp.
+	Ramp string
