new file mode 100644
index 0000000..89fe483
--- /dev/null
+++ b/internal/terminal/lifecycle_test.go
@@ -0,0 +1,93 @@
+package terminal
+
+import (
+	"context"
+	"io"
+	"os"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/lux-tui/lux/capability"
+	"github.com/lux-tui/lux/render"
+)
+
+type gatedWriter struct {
+	mu      sync.Mutex
+	started chan struct{}
+	release chan struct{}
+	data    []byte
+	once    sync.Once
+}
+
+func (w *gatedWriter) Write(data []byte) (int, error) {
+	w.once.Do(func() { close(w.started) })
+	<-w.release
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.data = append(w.data, data...)
+	return len(data), nil
+}
+
+func TestCanceledPresentNeverCommitsPrevious(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	output, err := os.CreateTemp(t.TempDir(), "output")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = output.Close() }()
+	backend := &Backend{opened: true, output: output, features: capability.Set{Color: capability.TrueColor}}
+	if err := backend.Present(ctx, render.NewBuffer(2, 1)); err == nil {
+		t.Fatal("canceled Present succeeded")
+	}
+	if backend.previous != nil {
+		t.Fatal("canceled Present committed a frame")
+	}
+}
+
+func TestWriteAllContextStopsBetweenPartialWrites(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	writer := &cancelingWriter{cancel: cancel}
+	err := writeAllContext(ctx, writer, []byte("abcdef"))
+	if err == nil || len(writer.data) != 1 {
+		t.Fatalf("write = %q, err=%v", writer.data, err)
+	}
+}
+
+type cancelingWriter struct {
+	cancel context.CancelFunc
+	data   []byte
+}
+
+func (w *cancelingWriter) Write(data []byte) (int, error) {
+	w.data = append(w.data, data[0])
+	w.cancel()
+	return 1, nil
+}
+
+func TestWriteAllContextRejectsZeroWrite(t *testing.T) {
+	err := writeAllContext(context.Background(), zeroWriter{}, []byte("x"))
+	if err != io.ErrShortWrite {
+		t.Fatalf("error = %v", err)
+	}
+}
+
+type zeroWriter struct{}
+
+func (zeroWriter) Write([]byte) (int, error) { return 0, nil }
+
+func TestGatedWriterFixture(t *testing.T) {
+	writer := &gatedWriter{started: make(chan struct{}), release: make(chan struct{})}
+	done := make(chan error, 1)
+	go func() { done <- writeAllContext(context.Background(), writer, []byte("frame")) }()
+	select {
+	case <-writer.started:
+	case <-time.After(time.Second):
+		t.Fatal("writer did not start")
+	}
+	close(writer.release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/internal/terminal/parser.go b/internal/terminal/parser.go
new file mode 100644
index 0000000..9847d30
--- /dev/null
+++ b/internal/terminal/parser.go
@@ -0,0 +1,288 @@
+package terminal
+
+import (
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/lux-tui/lux/event"
+)
+
+const (
+	maxSequence = 128
+	maxPaste    = 1 << 20
+	pasteStart  = "\x1b[200~"
+	pasteEnd    = "\x1b[201~"
+)
+
+type parser struct {
+	buffer  []byte
+	paste   []byte
+	inPaste bool
+}
+
+func newParser() *parser { return &parser{} }
+
+func (p *parser) pendingEscape() bool {
+	return len(p.buffer) > 0 && p.buffer[0] == 0x1b && !p.inPaste
+}
+
+func (p *parser) flushEscape() []event.Event {
+	if !p.pendingEscape() {
+		return nil
+	}
+	p.buffer = p.buffer[1:]
+	return []event.Event{event.KeyPress(event.KeyEscape, 0)}
+}
+
+func (p *parser) feed(data []byte, eof bool) []event.Event {
+	p.buffer = append(p.buffer, data...)
+	result := make([]event.Event, 0, 4)
+	for len(p.buffer) > 0 {
+		if p.inPaste {
+			end := strings.Index(string(p.buffer), pasteEnd)
+			if end < 0 {
+				keep := min(len(pasteEnd)-1, len(p.buffer))
+				p.appendPaste(p.buffer[:len(p.buffer)-keep])
+				p.buffer = p.buffer[len(p.buffer)-keep:]
+				break
+			}
+			p.appendPaste(p.buffer[:end])
+			p.buffer = p.buffer[end+len(pasteEnd):]
+			result = append(result, event.Event{Kind: event.Paste, Text: strings.ToValidUTF8(string(p.paste), "�")})
+			p.paste, p.inPaste = p.paste[:0], false
+			continue
+		}
+		if p.buffer[0] == 0x1b {
+			next, consumed, complete := parseEscape(p.buffer, eof)
+			if !complete {
+				if len(p.buffer) <= maxSequence {
+					break
+				}
+				next, consumed, complete = event.KeyPress(event.KeyEscape, 0), 1, true
+			}
+			if consumed == len(pasteStart) && string(p.buffer[:consumed]) == pasteStart {
+				p.buffer = p.buffer[consumed:]
+				p.inPaste = true
+				continue
+			}
+			if complete {
+				result = append(result, next)
+				p.buffer = p.buffer[consumed:]
+				continue
+			}
+		}
+		next, consumed, complete := parseRune(p.buffer, eof)
+		if !complete {
+			break
+		}
+		result = append(result, next)
+		p.buffer = p.buffer[consumed:]
+	}
+	if eof {
+		if p.inPaste {
+			p.appendPaste(p.buffer)
+			p.buffer = p.buffer[:0]
+			result = append(result, event.Event{Kind: event.Paste, Text: strings.ToValidUTF8(string(p.paste), "�")})
+			p.paste, p.inPaste = p.paste[:0], false
+		}
+		for len(p.buffer) > 0 {
+			if p.buffer[0] == 0x1b {
+				next, consumed, complete := parseEscape(p.buffer, true)
+				if complete {
+					result = append(result, next)
+					p.buffer = p.buffer[consumed:]
+					continue
+				}
+			}
+			next, consumed, _ := parseRune(p.buffer, true)
+			result = append(result, next)
+			p.buffer = p.buffer[consumed:]
+		}
+	}
+	return result
+}
+
+func (p *parser) appendPaste(data []byte) {
+	remaining := maxPaste - len(p.paste)
+	if remaining > 0 {
+		p.paste = append(p.paste, data[:min(remaining, len(data))]...)
+	}
+}
+
+func parseRune(data []byte, eof bool) (event.Event, int, bool) {
+	if len(data) == 0 {
+		return event.Event{}, 0, false
+	}
+	switch data[0] {
+	case '\r', '\n':
+		return event.KeyPress(event.KeyEnter, 0), 1, true
+	case '\t':
+		return event.KeyPress(event.KeyTab, 0), 1, true
+	case 0x7f, '\b':
+		return event.KeyPress(event.KeyBackspace, 0), 1, true
+	}
+	if data[0] < 0x20 {
+		if data[0] == 0 {
+			return event.RuneKey(' ', event.ModCtrl), 1, true
+		}
+		return event.RuneKey(rune(data[0]+'@'), event.ModCtrl), 1, true
+	}
+	if !utf8.FullRune(data) && !eof {
+		return event.Event{}, 0, false
+	}
+	r, size := utf8.DecodeRune(data)
+	if r == utf8.RuneError && size == 1 {
+		return event.Event{Kind: event.Text, Text: "�"}, 1, true
+	}
+	return event.RuneKey(r, 0), size, true
+}
+
+func parseEscape(data []byte, eof bool) (event.Event, int, bool) {
+	if len(data) == 1 {
+		if eof {
+			return event.KeyPress(event.KeyEscape, 0), 1, true
+		}
+		return event.Event{}, 0, false
+	}
+	if data[1] != '[' && data[1] != 'O' {
+		next, consumed, complete := parseRune(data[1:], eof)
+		if !complete {
+			return event.Event{}, 0, false
+		}
+		if next.Kind == event.Key {
+			next.Key.Mod |= event.ModAlt
+		}
+		return next, consumed + 1, true
+	}
+	end := sequenceEnd(data)
+	if end < 0 {
+		return event.Event{}, 0, false
+	}
+	sequence := string(data[:end+1])
+	if sequence == pasteStart {
+		return event.Event{}, len(sequence), true
+	}
+	if mouse, ok := parseMouse(sequence); ok {
+		return event.Event{Kind: event.Mouse, Mouse: mouse}, len(sequence), true
+	}
+	if focus, ok := map[string]bool{"\x1b[I": true, "\x1b[O": false}[sequence]; ok {
+		return event.Event{Kind: event.Focus, Focused: focus}, len(sequence), true
+	}
+	code, modifiers, ok := keySequence(sequence)
+	if ok {
+		return event.KeyPress(code, modifiers), len(sequence), true
+	}
+	return event.KeyPress(event.KeyUnknown, 0), len(sequence), true
+}
+
+func sequenceEnd(data []byte) int {
+	for index := 2; index < len(data) && index <= maxSequence; index++ {
+		if data[index] >= 0x40 && data[index] <= 0x7e {
+			return index
+		}
+	}
+	return -1
+}
+
+func keySequence(sequence string) (event.KeyCode, event.Mod, bool) {
+	simple := map[string]event.KeyCode{
+		"\x1b[A": event.KeyUp, "\x1b[B": event.KeyDown, "\x1b[C": event.KeyRight, "\x1b[D": event.KeyLeft,
+		"\x1b[H": event.KeyHome, "\x1b[F": event.KeyEnd, "\x1b[Z": event.KeyBackTab,
+		"\x1bOA": event.KeyUp, "\x1bOB": event.KeyDown, "\x1bOC": event.KeyRight, "\x1bOD": event.KeyLeft,
+		"\x1bOH": event.KeyHome, "\x1bOF": event.KeyEnd,
+		"\x1bOP": event.KeyF1, "\x1bOQ": event.KeyF2, "\x1bOR": event.KeyF3, "\x1bOS": event.KeyF4,
+	}
+	if code, ok := simple[sequence]; ok {
+		return code, 0, true
+	}
+	final := sequence[len(sequence)-1]
+	body := sequence[2 : len(sequence)-1]
+	parts := strings.Split(body, ";")
+	modifier := event.Mod(0)
+	if len(parts) > 1 {
+		value, err := strconv.Atoi(parts[len(parts)-1])
+		if err == nil {
+			modifier = decodeModifier(value)
+		}
+	}
+	if final != '~' {
+		codes := map[byte]event.KeyCode{'A': event.KeyUp, 'B': event.KeyDown, 'C': event.KeyRight, 'D': event.KeyLeft, 'H': event.KeyHome, 'F': event.KeyEnd, 'P': event.KeyF1, 'Q': event.KeyF2, 'R': event.KeyF3, 'S': event.KeyF4}
+		code, ok := codes[final]
+		return code, modifier, ok
+	}
+	value, err := strconv.Atoi(parts[0])
+	if err != nil {
+		return event.KeyUnknown, 0, false
+	}
+	codes := map[int]event.KeyCode{1: event.KeyHome, 2: event.KeyInsert, 3: event.KeyDelete, 4: event.KeyEnd, 5: event.KeyPageUp, 6: event.KeyPageDown, 7: event.KeyHome, 8: event.KeyEnd, 11: event.KeyF1, 12: event.KeyF2, 13: event.KeyF3, 14: event.KeyF4, 15: event.KeyF5, 17: event.KeyF6, 18: event.KeyF7, 19: event.KeyF8, 20: event.KeyF9, 21: event.KeyF10, 23: event.KeyF11, 24: event.KeyF12}
+	code, ok := codes[value]
+	return code, modifier, ok
+}
+
+func decodeModifier(value int) event.Mod {
+	if value <= 1 {
+		return 0
+	}
+	bits := value - 1
+	var result event.Mod
+	if bits&1 != 0 {
+		result |= event.ModShift
+	}
+	if bits&2 != 0 {
+		result |= event.ModAlt
+	}
+	if bits&4 != 0 {
+		result |= event.ModCtrl
+	}
+	if bits&8 != 0 {
+		result |= event.ModSuper
+	}
+	return result
+}
+
+func parseMouse(sequence string) (event.MouseEvent, bool) {
+	if !strings.HasPrefix(sequence, "\x1b[<") {
+		return event.MouseEvent{}, false
+	}
+	final := sequence[len(sequence)-1]
+	if final != 'M' && final != 'm' {
+		return event.MouseEvent{}, false
+	}
+	parts := strings.Split(sequence[3:len(sequence)-1], ";")
+	if len(parts) != 3 {
+		return event.MouseEvent{}, false
+	}
+	button, err1 := strconv.Atoi(parts[0])
+	x, err2 := strconv.Atoi(parts[1])
+	y, err3 := strconv.Atoi(parts[2])
+	if err1 != nil || err2 != nil || err3 != nil || x < 1 || y < 1 || button < 0 || button > 255 {
+		return event.MouseEvent{}, false
+	}
+	mouse := event.MouseEvent{X: x - 1, Y: y - 1}
+	if button&4 != 0 {
+		mouse.Mod |= event.ModShift
+	}
+	if button&8 != 0 {
+		mouse.Mod |= event.ModAlt
+	}
+	if button&16 != 0 {
+		mouse.Mod |= event.ModCtrl
+	}
+	base := button & 3
+	if button&64 != 0 {
+		mouse.Action = event.MouseWheel
+		mouse.Button = [...]event.MouseButton{event.MouseWheelUp, event.MouseWheelDown, event.MouseWheelLeft, event.MouseWheelRight}[base]
+	} else if final == 'm' || base == 3 {
+		mouse.Action = event.MouseRelease
+		mouse.Button = event.MouseNone
+	} else {
+		mouse.Button = [...]event.MouseButton{event.MouseLeft, event.MouseMiddle, event.MouseRight, event.MouseNone}[base]
+		if button&32 != 0 {
+			mouse.Action = event.MouseMove
+		} else {
+			mouse.Action = event.MousePress
+		}
+	}
+	return mouse, true
+}
diff --git a/internal/terminal/platform_unix.go b/internal/terminal/platform_unix.go
new file mode 100644
index 0000000..f4532dc
--- /dev/null
+++ b/internal/terminal/platform_unix.go
@@ -0,0 +1,91 @@
+//go:build !windows
+
+package terminal
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"github.com/lux-tui/lux/event"
+	"golang.org/x/sys/unix"
+	"golang.org/x/term"
+)
+
+func enableVT(*os.File) (func() error, error) { return nil, nil }
+
+func duplicateFile(file *os.File, name string) (*os.File, error) {
+	if file == nil {
+		return nil, nil
+	}
+	fd, err := unix.Dup(int(file.Fd()))
+	if err != nil {
+		return nil, err
+	}
+	return os.NewFile(uintptr(fd), name), nil
+}
+
+func terminalSize(file *os.File) (int, int, error) { return term.GetSize(int(file.Fd())) }
+
+var errReadTimeout = errors.New("terminal: read timeout")
+
+func readInput(ctx context.Context, file *os.File, buffer []byte, timeout time.Duration) (int, error) {
+	fd := int(file.Fd())
+	milliseconds := 100
+	if timeout >= 0 {
+		milliseconds = max(1, int(timeout/time.Millisecond))
+	}
+	for {
+		ready, err := unix.Poll([]unix.PollFd{{Fd: int32(fd), Events: unix.POLLIN}}, milliseconds)
+		if err != nil && err != syscall.EINTR {
+			return 0, err
+		}
+		if ctx.Err() != nil {
+			return 0, ctx.Err()
+		}
+		if ready > 0 {
+			return file.Read(buffer)
+		}
+		if timeout >= 0 {
+			return 0, errReadTimeout
+		}
+	}
+}
+
+func cancelRead(*os.File) {}
+
+type resizeWatcher struct {
+	signals chan os.Signal
+}
+
+func (w *resizeWatcher) start(ctx context.Context, file *os.File, events chan<- event.Event) {
+	w.signals = make(chan os.Signal, 1)
+	signal.Notify(w.signals, syscall.SIGWINCH)
+	go func(signals <-chan os.Signal) {
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-signals:
+				width, height, err := terminalSize(file)
+				if err != nil {
+					continue
+				}
+				select {
+				case events <- event.ResizeTo(width, height):
+				default:
+				}
+			}
+		}
+	}(w.signals)
+}
+
+func (w *resizeWatcher) stop() {
+	if w.signals != nil {
+		signal.Stop(w.signals)
+		w.signals = nil
+	}
+}
diff --git a/internal/terminal/platform_windows.go b/internal/terminal/platform_windows.go
new file mode 100644
index 0000000..9a47354
--- /dev/null
+++ b/internal/terminal/platform_windows.go
@@ -0,0 +1,113 @@
+//go:build windows
+
+package terminal
+
+import (
+	"context"
+	"errors"
+	"os"
+	"time"
+
+	"github.com/lux-tui/lux/event"
+	"golang.org/x/sys/windows"
+	"golang.org/x/term"
+)
+
+const enableVirtualTerminalProcessing = 0x0004
+
+func enableVT(file *os.File) (func() error, error) {
+	handle := windows.Handle(file.Fd())
+	var mode uint32
+	if err := windows.GetConsoleMode(handle, &mode); err != nil {
+		return nil, err
+	}
+	if err := windows.SetConsoleMode(handle, mode|enableVirtualTerminalProcessing); err != nil {
+		return nil, err
+	}
+	return func() error { return windows.SetConsoleMode(handle, mode) }, nil
+}
+
+func duplicateFile(file *os.File, name string) (*os.File, error) {
+	if file == nil {
+		return nil, nil
+	}
+	process, err := windows.GetCurrentProcess()
+	if err != nil {
+		return nil, err
+	}
+	var duplicate windows.Handle
+	if err := windows.DuplicateHandle(process, windows.Handle(file.Fd()), process, &duplicate, 0, false, windows.DUPLICATE_SAME_ACCESS); err != nil {
+		return nil, err
+	}
+	return os.NewFile(uintptr(duplicate), name), nil
+}
+
+func terminalSize(file *os.File) (int, int, error) { return term.GetSize(int(file.Fd())) }
+
+var errReadTimeout = errors.New("terminal: read timeout")
+
+func readInput(ctx context.Context, file *os.File, buffer []byte, timeout time.Duration) (int, error) {
+	handle := windows.Handle(file.Fd())
+	milliseconds := uint32(100)
+	if timeout >= 0 {
+		milliseconds = uint32(max(1, int(timeout/time.Millisecond)))
+	}
+	for {
+		result, err := windows.WaitForSingleObject(handle, milliseconds)
+		if err != nil {
+			return 0, err
+		}
+		if ctx.Err() != nil {
+			return 0, ctx.Err()
+		}
+		if result == windows.WAIT_OBJECT_0 {
+			return file.Read(buffer)
+		}
+		if timeout >= 0 {
+			return 0, errReadTimeout
+		}
+	}
+}
+
+func cancelRead(file *os.File) {
+	if file != nil {
+		_ = windows.CancelIoEx(windows.Handle(file.Fd()), nil)
+	}
+}
+
+type resizeWatcher struct {
+	cancel context.CancelFunc
+}
+
+func (w *resizeWatcher) start(parent context.Context, file *os.File, events chan<- event.Event) {
+	ctx, cancel := context.WithCancel(parent)
+	w.cancel = cancel
+	go func() {
+		width, height, _ := terminalSize(file)
+		ticker := time.NewTicker(100 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				nextWidth, nextHeight, err := terminalSize(file)
+				if err != nil || nextWidth == width && nextHeight == height {
+					continue
+				}
+				width, height = nextWidth, nextHeight
+				select {
+				case events <- event.ResizeTo(width, height):
+				default:
+				}
+			}
+		}
+	}()
+}
+
+func (w *resizeWatcher) stop() {
+	if w.cancel != nil {
+		w.cancel()
+		w.cancel = nil
+	}
+}
diff --git a/internal/terminal/terminal_test.go b/internal/terminal/terminal_test.go
new file mode 100644
index 0000000..3229865
--- /dev/null
+++ b/internal/terminal/terminal_test.go
@@ -0,0 +1,248 @@
+package terminal
+
+import (
+	"context"
+	"errors"
+	"os"
+	"reflect"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/lux-tui/lux/capability"
+	"github.com/lux-tui/lux/event"
+	"github.com/lux-tui/lux/render"
+)
+
+func TestParserStreamingKeysUTF8AndModifiers(t *testing.T) {
+	parser := newParser()
+	var got []event.Event
+	for _, chunk := range [][]byte{[]byte("a\x1b["), []byte("A\x1b[1;6D"), []byte("\x1bé"), []byte("\x03")} {
+		got = append(got, parser.feed(chunk, false)...)
+	}
+	want := []event.Event{
+		event.RuneKey('a', 0),
+		event.KeyPress(event.KeyUp, 0),
+		event.KeyPress(event.KeyLeft, event.ModShift|event.ModCtrl),
+		event.RuneKey('é', event.ModAlt),
+		event.RuneKey('C', event.ModCtrl),
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("events = %#v, want %#v", got, want)
+	}
+}
+
+func TestParserMousePasteFocusAndFunctions(t *testing.T) {
+	input := "\x1b[<20;7;9M\x1b[<64;2;3M\x1b[I\x1b[O\x1b[15~\x1b[200~hello\x1b[31m界\x1b[201~"
+	got := newParser().feed([]byte(input), false)
+	if len(got) != 6 {
+		t.Fatalf("event count = %d: %#v", len(got), got)
+	}
+	if mouse := got[0].Mouse; got[0].Kind != event.Mouse || mouse.X != 6 || mouse.Y != 8 || mouse.Action != event.MousePress || mouse.Button != event.MouseLeft || mouse.Mod != event.ModCtrl|event.ModShift {
+		t.Fatalf("press = %#v", got[0])
+	}
+	if mouse := got[1].Mouse; mouse.Action != event.MouseWheel || mouse.Button != event.MouseWheelUp || mouse.X != 1 || mouse.Y != 2 {
+		t.Fatalf("wheel = %#v", got[1])
+	}
+	if got[2].Kind != event.Focus || !got[2].Focused || got[3].Kind != event.Focus || got[3].Focused {
+		t.Fatalf("focus = %#v %#v", got[2], got[3])
+	}
+	if !got[4].Key.Is(event.KeyF5, 0) {
+		t.Fatalf("function key = %#v", got[4])
+	}
+	// The paste payload remains opaque, including escape sequences.
+	if got[5].Kind != event.Paste || got[5].Text != "hello\x1b[31m界" {
+		t.Fatalf("paste = %#v", got[5])
+	}
+}
+
+func TestParserBoundedMalformedInput(t *testing.T) {
+	parser := newParser()
+	got := parser.feed(append([]byte{0x1b, '['}, []byte(strings.Repeat("1", maxSequence+5))...), false)
+	if len(parser.buffer) > maxSequence || len(got) == 0 || !got[0].Key.Is(event.KeyEscape, 0) {
+		t.Fatalf("unbounded or unconsumed escape: buffered=%d events=%#v", len(parser.buffer), got)
+	}
+
+	parser = newParser()
+	payload := strings.Repeat("x", maxPaste+100)
+	got = parser.feed([]byte(pasteStart+payload+pasteEnd), false)
+	if len(got) != 1 || got[0].Kind != event.Paste || len(got[0].Text) != maxPaste {
+		t.Fatalf("bounded paste len=%d events=%d", len(got[0].Text), len(got))
+	}
+}
+
+func TestParserLoneEscapeTimeout(t *testing.T) {
+	parser := newParser()
+	if got := parser.feed([]byte{0x1b}, false); len(got) != 0 || !parser.pendingEscape() {
+		t.Fatalf("lone escape was not buffered: %#v", got)
+	}
+	got := parser.flushEscape()
+	if len(got) != 1 || !got[0].Key.Is(event.KeyEscape, 0) || parser.pendingEscape() {
+		t.Fatalf("escape timeout = %#v", got)
+	}
+}
+
+func TestReadLoopClosesCapturedDoneChannel(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("anonymous pipes are not console input handles on Windows")
+	}
+	input, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = input.Close() }()
+	done := make(chan struct{})
+	backend := &Backend{input: input}
+	go backend.readLoop(context.Background(), done, make(chan event.Event, 1), newParser())
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("read loop did not close its captured generation channel")
+	}
+}
+
+func TestANSIFrameExactDiffAndWideCells(t *testing.T) {
+	frame := render.NewBuffer(5, 1)
+	canvas := render.NewCanvas(frame)
+	style := render.Style{Foreground: render.RGBColor(1, 2, 3), Background: render.IndexedColor(42), Attrs: render.AttrBold}
+	canvas.Text(0, 0, "A界B", style)
+	got := string(appendFrame(nil, frame, nil, capability.TrueColor, false))
+	want := "\x1b[1;1H\x1b[0;1;38;2;1;2;3;48;5;42mA界B\x1b[0m \x1b[0m"
+	if got != want {
+		t.Fatalf("full frame\n got: %q\nwant: %q", got, want)
+	}
+
+	previous := frame.Clone()
+	if got := appendFrame(nil, frame, previous, capability.TrueColor, true); len(got) != 0 {
+		t.Fatalf("unchanged synchronized frame = %q", got)
+	}
+	canvas.Put(4, 0, "X", render.Style{})
+	got = string(appendFrame(nil, frame, previous, capability.ANSI16, true))
+	want = "\x1b[?2026h\x1b[1;5H\x1b[0mX\x1b[0m\x1b[?2026l"
+	if got != want {
+		t.Fatalf("diff\n got: %q\nwant: %q", got, want)
+	}
+}
+
+func TestANSIFrameSkipsColorsEquivalentAfterDowngrade(t *testing.T) {
+	previous := render.NewBuffer(1, 1)
+	frame := render.NewBuffer(1, 1)
+	render.NewCanvas(previous).Put(0, 0, "x", render.Style{Foreground: render.RGBColor(255, 0, 0)})
+	render.NewCanvas(frame).Put(0, 0, "x", render.Style{Foreground: render.ANSIColor(9)})
+	if got := appendFrame(nil, frame, previous, capability.ANSI16, false); len(got) != 0 {
+		t.Fatalf("equivalent downgraded color emitted diff: %q", got)
+	}
+	if got := appendFrame(nil, frame, previous, capability.TrueColor, false); len(got) == 0 {
+		t.Fatal("different true colors did not emit diff")
+	}
+}
+
+func TestColorDowngradeAndPlainFrame(t *testing.T) {
+	style := render.Style{Foreground: render.RGBColor(255, 0, 0), Background: render.IndexedColor(21)}
+	if got, want := string(appendStyle(nil, style, capability.ANSI16)), "\x1b[0;91;104m"; got != want {
+		t.Fatalf("ANSI16 style = %q, want %q", got, want)
+	}
+	if got, want := string(appendStyle(nil, style, capability.ANSI256)), "\x1b[0;38;5;196;48;5;21m"; got != want {
+		t.Fatalf("ANSI256 style = %q, want %q", got, want)
+	}
+
+	frame := render.NewBuffer(4, 2)
+	canvas := render.NewCanvas(frame)
+	canvas.Text(0, 0, "hi", style)
+	canvas.Text(0, 1, "界", style)
+	if got, want := string(appendPlain(nil, frame)), "hi\n界\n"; got != want {
+		t.Fatalf("plain frame = %q, want %q", got, want)
+	}
+}
+
+func TestPlainBackendLifecycleAndFullWrites(t *testing.T) {
+	t.Setenv("TERM", "dumb")
+	file, err := os.CreateTemp(t.TempDir(), "terminal-output")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = file.Close() }()
+	backend := New(nil, file)
+	features, err := backend.Open(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if features.Interactive || features.Color != capability.Monochrome {
+		t.Fatalf("plain capabilities = %#v", features)
+	}
+	frame := render.NewBuffer(2, 1)
+	render.NewCanvas(frame).Text(0, 0, "ok", render.Style{})
+	if err := backend.Present(context.Background(), frame); err != nil {
+		t.Fatal(err)
+	}
+	if err := backend.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := backend.Close(); err != nil {
+		t.Fatalf("idempotent Close: %v", err)
+	}
+	if _, _, err := backend.Size(); err == nil {
+		t.Fatal("redirected Size succeeded")
+	}
+	if _, err := file.Seek(0, 0); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(file.Name())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != "ok\n" {
+		t.Fatalf("output = %q", data)
+	}
+}
+
+func TestBackendErrors(t *testing.T) {
+	backend := New(nil, nil)
+	if err := backend.Present(context.Background(), render.NewBuffer(1, 1)); err == nil {
+		t.Fatal("Present before Open succeeded")
+	}
+	if err := backend.Present(context.Background(), nil); err == nil {
+		t.Fatal("nil Present succeeded")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := backend.NextEvent(ctx); err == nil {
+		t.Fatal("NextEvent before Open succeeded")
+	}
+
+	t.Setenv("TERM", "dumb")
+	backend = New(nil, os.Stdout)
+	if _, err := backend.Open(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := backend.NextEvent(ctx); !errors.Is(err, context.Canceled) {
+		t.Fatalf("NextEvent error = %v", err)
+	}
+	_ = backend.Close()
+}
+
+func FuzzParserNeverPanics(f *testing.F) {
+	for _, seed := range [][]byte{[]byte("hello"), []byte("\x1b[A"), []byte("\x1b[<0;1;1M"), []byte(pasteStart + "x" + pasteEnd), {0xff, 0x80, 0x1b}} {
+		f.Add(seed)
+	}
+	f.Fuzz(func(t *testing.T, data []byte) {
+		parser := newParser()
+		mid := len(data) / 2
+		_ = parser.feed(data[:mid], false)
+		_ = parser.feed(data[mid:], true)
+		if len(parser.buffer) > maxSequence || len(parser.paste) > maxPaste {
+			t.Fatalf("parser exceeded limits: buffer=%d paste=%d", len(parser.buffer), len(parser.paste))
+		}
+	})
+}
+
+func TestParserEOFCompletesEscapeAndNUL(t *testing.T) {
+	got := newParser().feed([]byte("\x1b[A\x00"), true)
+	if len(got) != 2 || !got[0].Key.Is(event.KeyUp, 0) || got[1].Key.Rune != ' ' || got[1].Key.Mod != event.ModCtrl {
+		t.Fatalf("EOF events = %#v", got)
+	}
+}
diff --git a/layout/layout.go b/layout/layout.go
new file mode 100644
index 0000000..6fdca2b
--- /dev/null
+++ b/layout/layout.go
@@ -0,0 +1,150 @@
+// Package layout provides small, content-driven responsive layout primitives.
+package layout
+
+import "github.com/lux-tui/lux/render"
+
+// Class is a coarse disclosure level derived from available cells.
+type Class uint8
+
+const (
+	Tiny Class = iota
+	Compact
+	Medium
+	Wide
+)
+
+// Classify uses both dimensions: wide but one-line terminals remain compact.
+func Classify(area render.Rect) Class {
+	if area.W < 12 || area.H < 3 {
+		return Tiny
+	}
+	if area.W < 60 || area.H < 16 {
+		return Compact
+	}
+	if area.W < 110 || area.H < 28 {
+		return Medium
+	}
+	return Wide
+}
+
+// Axis selects rows or columns.
+type Axis uint8
+
+const (
+	Horizontal Axis = iota
+	Vertical
+)
+
+// Constraint describes a child's main-axis size. Basis is preferred cells,
+// Min and Max clamp it, Grow shares spare cells, Shrink shares a deficit.
+type Constraint struct {
+	Basis  int
+	Min    int
+	Max    int
+	Grow   int
+	Shrink int
+}
+
+// Flex divides area deterministically. It uses caller storage and returns a
+// slice of exactly len(items), making responsive layout allocation-free.
+func Flex(into []render.Rect, area render.Rect, axis Axis, gap int, items ...Constraint) []render.Rect {
+	if len(into) < len(items) {
+		panic("layout: destination is smaller than constraints")
+	}
+	into = into[:len(items)]
+	if len(items) == 0 {
+		return into
+	}
+	gap = max(gap, 0)
+	available := area.W
+	if axis == Vertical {
+		available = area.H
+	}
+	available = max(available, 0)
+	if len(items) > 1 {
+		// Reserve a cell per child before spending scarce space on decoration.
+		gap = min(gap, max(available-len(items), 0)/(len(items)-1))
+	}
+	available = max(available-gap*(len(items)-1), 0)
+	used := 0
+	for index, item := range items {
+		maximum := item.Max
+		if maximum <= 0 {
+			maximum = available
+		}
+		into[index].W = min(max(item.Basis, max(item.Min, 0)), maximum)
+		used += into[index].W
+	}
+	delta := available - used
+	if delta > 0 {
+		distribute(into, items, delta, true)
+	} else if delta < 0 {
+		distribute(into, items, -delta, false)
+		used = 0
+		for index := range into {
+			used += into[index].W
+		}
+		// At tiny sizes minimums become preferences: containment beats overflow.
+		for index := len(into) - 1; used > available && index >= 0; index-- {
+			cut := min(into[index].W, used-available)
+			into[index].W -= cut
+			used -= cut
+		}
+	}
+	position := 0
+	for index := range into {
+		size := into[index].W
+		if axis == Horizontal {
+			into[index] = render.Rect{X: area.X + position, Y: area.Y, W: size, H: max(area.H, 0)}
+		} else {
+			into[index] = render.Rect{X: area.X, Y: area.Y + position, W: max(area.W, 0), H: size}
+		}
+		position += size + gap
+	}
+	return into
+}
+
+func distribute(sizes []render.Rect, items []Constraint, amount int, grow bool) {
+	for amount > 0 {
+		weight := 0
+		for index, item := range items {
+			if grow && item.Grow > 0 && (item.Max <= 0 || sizes[index].W < item.Max) {
+				weight += item.Grow
+			} else if !grow && item.Shrink > 0 && sizes[index].W > max(item.Min, 0) {
+				weight += item.Shrink
+			}
+		}
+		if weight == 0 {
+			return
+		}
+		changed := 0
+		for index, item := range items {
+			w := item.Grow
+			room := item.Max - sizes[index].W
+			if item.Max <= 0 {
+				room = amount
+			}
+			if !grow {
+				w, room = item.Shrink, sizes[index].W-max(item.Min, 0)
+			}
+			if w <= 0 || room <= 0 {
+				continue
+			}
+			share := max(1, amount*w/weight)
+			share = min(share, room, amount-changed)
+			if grow {
+				sizes[index].W += share
+			} else {
+				sizes[index].W -= share
+			}
+			changed += share
+			if changed == amount {
+				break
+			}
+		}
+		if changed == 0 {
+			return
+		}
+		amount -= changed
+	}
+}
