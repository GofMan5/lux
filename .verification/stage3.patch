+
+func (t *TextInput) prepareHistory() {
+	limit := t.historyLimit()
+	if limit < 0 {
+		t.clearHistory()
+		return
+	}
+	t.trimHistory(&t.undo, &t.undoBytes, limit)
+	t.trimHistory(&t.redo, &t.redoBytes, limit)
